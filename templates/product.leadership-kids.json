le__highlight {\n    display: inline-block;\n    background: #f5a623;\n    color: #0d1b3e;\n    border-radius: 6px;\n    padding: 2px 10px;\n    font-style: normal;\n    font-weight: 900;\n    font-size: 95%;\n    line-height: 1.4;\n  }\n  .pib-title em {\n    font-style: italic;\n    color: #c0392b;\n    font-weight: 400;\n  }\n\n  /* ─────────────────────────────\n     STARS\n  ───────────────────────────── */\n  .pib-stars-row {\n    display: flex; align-items: center;\n    gap: 7px; margin-bottom: 20px; flex-wrap: wrap;\n  }\n  .pib-stars { color: #f59e0b; font-size: 16px; letter-spacing: 1.5px; line-height: 1; }\n  .pib-rating-num { font-size: 13.5px; font-weight: 800; color: #0d1b3e; }\n  .pib-review-sep { color: #d1d5db; font-size: 13px; }\n  .pib-review-count {\n    font-size: 13px; color: #6b7280; font-weight: 600;\n    text-decoration: underline; text-underline-offset: 2px;\n    text-decoration-color: rgba(107,114,128,0.3); transition: color 0.15s ease;\n  }\n  .pib-review-count:hover { color: #0d1b3e; }\n\n  /* ─────────────────────────────\n     DIVIDER\n  ───────────────────────────── */\n  .pib-divider {\n    width: 100%; height: 1px;\n    background: rgba(13,27,62,0.07); margin: 4px 0 20px 0;\n  }\n\n  /* ─────────────────────────────\n     PRICE\n  ───────────────────────────── */\n  .pib-price-block { margin-bottom: 6px; }\n  .pib-price-row {\n    display: flex; align-items: center;\n    gap: 10px; flex-wrap: wrap; margin-bottom: 8px;\n  }\n  .pib-price-current {\n    font-size: clamp(36px, 7vw, 44px); font-weight: 900;\n    color: #c0392b; line-height: 1; letter-spacing: -2px;\n  }\n  .pib-price-original { line-height: 1; }\n  .pib-price-original s {\n    font-size: 17px; color: #9ca3af;\n    font-weight: 500; text-decoration-color: #9ca3af;\n  }\n  .pib-price-badge {\n    background: #c0392b; color: #fff; border-radius: 5px;\n    padding: 5px 10px; font-size: 12px; font-weight: 900;\n    text-transform: uppercase; letter-spacing: 0.07em;\n    line-height: 1; white-space: nowrap; align-self: center;\n  }\n  .pib-price-note {\n    display: flex; align-items: center; gap: 5px;\n    font-size: 13px; color: #6b7280; margin-bottom: 20px;\n  }\n  .pib-price-note strong { color: #0d1b3e; font-weight: 700; }\n\n  /* ─────────────────────────────\n     BULLETS\n  ───────────────────────────── */\n  .pib-bullets { list-style: none; padding: 0; margin: 0; }\n  .pib-bullet {\n    display: flex; align-items: flex-start; gap: 11px;\n    padding: 10px 0; border-bottom: 1px solid rgba(13,27,62,0.06);\n    font-size: clamp(14px, 2vw, 15px); color: #0d1b3e; line-height: 1.5;\n  }\n  .pib-bullet:last-child { border-bottom: none; }\n  .pib-check {\n    display: flex; align-items: center; justify-content: center;\n    width: 20px; height: 20px; min-width: 20px; border-radius: 50%;\n    background: #dcfce7; color: #166534; font-size: 10px;\n    font-weight: 900; flex-shrink: 0; margin-top: 1px; line-height: 1;\n  }\n\n  /* ─────────────────────────────\n     MOBILE\n  ───────────────────────────── */\n  @media (max-width: 480px) {\n    .pib-wrap { max-width: 100%; }\n    .pib-carousel { padding: 18px 16px 14px; }\n    .pib-carousel__bg-quote { font-size: 72px; right: 10px; }\n    .pib-title { font-size: 20px; }\n    .pib-title__highlight { padding: 2px 8px; }\n    .pib-price-current { letter-spacing: -1.5px; }\n    .pib-scarcity { font-size: 12.5px; padding: 7px 12px; }\n    .pib-bullet { font-size: 14px; padding: 9px 0; }\n    .pib-slide__avatar { width: 32px; height: 32px; }\n  }\n\n</style>\n\n<script>\n(function() {\n  var slides  = document.querySelectorAll('.pib-slide');\n  var dots    = document.querySelectorAll('.pib-dot');\n  var current = 0;\n  function goTo(idx) {\n    slides[current].classList.remove('active');\n    dots[current].classList.remove('active');\n    current = idx;\n    slides[current].classList.add('active');\n    dots[current].classList.add('active');\n  }\n\n  dots.forEach(function(dot) {\n    dot.addEve