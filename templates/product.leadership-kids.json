          "settings": {
            "custom_liquid": "<div class=\"pib-wrap\">\n\n  <!-- TESTIMONIAL CAROUSEL -->\n  <div class=\"pib-carousel\">\n    <div class=\"pib-carousel__bg-quote\">\"</div>\n    <div class=\"pib-slides\">\n\n      <div class=\"pib-slide active\">\n        <p class=\"pib-slide__text\">\"My kids were instantly hooked by the colorful illustrations. It teaches important life lessons in a way that's easy for them to understand — and they actually remember it.\"</p>\n        <div class=\"pib-slide__author\">\n          <img class=\"pib-slide__avatar\" src=\"https://i.pravatar.cc/150?img=47\" alt=\"Sarah M.\" />\n          <div>\n            <div class=\"pib-slide__name\">Sarah M.</div>\n            <div class=\"pib-slide__meta\">Mom of two &nbsp;·&nbsp; <span class=\"pib-slide__stars\">★★★★★</span></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"pib-slide\">\n        <p class=\"pib-slide__text\">\"My son read this in two sittings. He started setting goals for his week and actually following through. I didn't teach him that — the book did. Best thing we've bought this year.\"</p>\n        <div class=\"pib-slide__author\">\n          <img class=\"pib-slide__avatar\" src=\"https://i.pravatar.cc/150?img=12\" alt=\"James R.\" />\n          <div>\n            <div class=\"pib-slide__name\">James R.</div>\n            <div class=\"pib-slide__meta\">Father of three &nbsp;·&nbsp; <span class=\"pib-slide__stars\">★★★★★</span></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"pib-slide\">\n        <p class=\"pib-slide__text\">\"Finally a book that teaches kids HOW to think, not just what to think. My daughter reads it like a comic and talks about leadership at dinner now. I love it.\"</p>\n        <div class=\"pib-slide__author\">\n          <img class=\"pib-slide__avatar\" src=\"https://i.pravatar.cc/150?img=32\" alt=\"Emily T.\" />\n          <div>\n            <div class=\"pib-slide__name\">Emily T.</div>\n            <div class=\"pib-slide__meta\">Mom of one &nbsp;·&nbsp; <span class=\"pib-slide__stars\">★★★★★</span></div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n    <div class=\"pib-dots\">\n      <span class=\"pib-dot active\" data-i=\"0\"></span>\n      <span class=\"pib-dot\" data-i=\"1\"></span>\n      <span class=\"pib-dot\" data-i=\"2\"></span>\n    </div>\n  </div>\n\n  <!-- SCARCITY BADGE -->\n  <div class=\"pib-scarcity\">\n    <span class=\"pib-scarcity__pulse\"></span>\n    #6 Amazon Bestseller — low stock remaining\n  </div>\n\n  <!-- TITLE -->\n  <h1 class=\"pib-title\">\n    Leadership <span class=\"pib-title__highlight\">Enlightenment</span><br>\n    <em>for Kids — A Guide to Benefit a Lifetime</em>\n  </h1>\n\n  <!-- STARS -->\n  <div class=\"pib-stars-row\">\n    <span class=\"pib-stars\">★★★★★</span>\n    <span class=\"pib-rating-num\">4.6</span>\n    <span class=\"pib-review-sep\">·</span>\n    <a href=\"#reviews\" class=\"pib-review-count\">194 reviews</a>\n  </div>\n\n  <!-- DIVIDER -->\n  <div class=\"pib-divider\"></div>\n\n  <!-- PRICE -->\n  <div class=\"pib-price-block\">\n    <div class=\"pib-price-row\">\n      <span class=\"pib-price-current\">{{ product.price | money }}</span>\n      <span class=\"pib-price-original\"><s>{{ product.price | times: 2 | money }}</s></span>\n      <span class=\"pib-price-badge\">50% OFF</span>\n    </div>\n    <div class=\"pib-price-note\">\n      🎉 You save <strong>{{ product.price | money }}</strong> today only\n    </div>\n  </div>\n\n  <!-- DIVIDER -->\n  <div class=\"pib-divider\"></div>\n\n  <!-- BULLETS -->\n  <ul class=\"pib-bullets\">\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>42 leadership principles kids can actually use</span>\n    </li>\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>Builds resilience, confidence &amp; critical thinking</span>\n    </li>\n    <li class=\