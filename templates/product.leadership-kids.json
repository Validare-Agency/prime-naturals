      "blocks": {
        "custom_liquid_mN8rj9": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"pib-wrap\">\n\n  <!-- TESTIMONIAL CAROUSEL -->\n  <div class=\"pib-carousel\">\n    <div class=\"pib-carousel__bg-quote\">\"</div>\n    <div class=\"pib-slides\">\n\n      <div class=\"pib-slide active\">\n        <p class=\"pib-slide__text\">\"My kids were instantly hooked by the colorful illustrations. It teaches important life lessons in a way that's easy for them to understand — and they actually remember it.\"</p>\n        <div class=\"pib-slide__author\">\n          <img class=\"pib-slide__avatar\" src=\"https://i.pravatar.cc/150?img=47\" alt=\"Sarah M.\" />\n          <div>\n            <div class=\"pib-slide__name\">Sarah M.</div>\n            <div class=\"pib-slide__meta\">Mom of two &nbsp;·&nbsp; <span class=\"pib-slide__stars\">★★★★★</span></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"pib-slide\">\n        <p class=\"pib-slide__text\">\"My son read this in two sittings. He started setting goals for his week and actually following through. I didn't teach him that — the book did. Best thing we've bought this year.\"</p>\n        <div class=\"pib-slide__author\">\n          <img class=\"pib-slide__avatar\" src=\"https://i.pravatar.cc/150?img=12\" alt=\"James R.\" />\n          <div>\n            <div class=\"pib-slide__name\">James R.</div>\n            <div class=\"pib-slide__meta\">Father of three &nbsp;·&nbsp; <span class=\"pib-slide__stars\">★★★★★</span></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"pib-slide\">\n        <p class=\"pib-slide__text\">\"Finally a book that teaches kids HOW to think, not just what to think. My daughter reads it like a comic and talks about leadership at dinner now. I love it.\"</p>\n        <div class=\"pib-slide__author\">\n          <img class=\"pib-slide__avatar\" src=\"https://i.pravatar.cc/150?img=32\" alt=\"Emily T.\" />\n          <div>\n            <div class=\"pib-slide__name\">Emily T.</div>\n            <div class=\"pib-slide__meta\">Mom of one &nbsp;·&nbsp; <span class=\"pib-slide__stars\">★★★★★</span></div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n    <div class=\"pib-dots\">\n      <span class=\"pib-dot active\" data-i=\"0\"></span>\n      <span class=\"pib-dot\" data-i=\"1\"></span>\n      <span class=\"pib-dot\" data-i=\"2\"></span>\n    </div>\n  </div>\n\n  <!-- SCARCITY BADGE -->\n  <div class=\"pib-scarcity\">\n    <span class=\"pib-scarcity__pulse\"></span>\n    #6 Amazon Bestseller — low stock remaining\n  </div>\n\n  <!-- TITLE -->\n  <h1 class=\"pib-title\">\n    Leadership <span class=\"pib-title__highlight\">Enlightenment</span><br>\n    <em>for Kids — A Guide to Benefit a Lifetime</em>\n  </h1>\n\n  {% render 'pdp20-badges' %}\n\n  <!-- STARS -->\n  <div class=\"pib-stars-row\">\n    <span class=\"pib-stars\">★★★★★</span>\n    <span class=\"pib-rating-num\">4.6</span>\n    <span class=\"pib-review-sep\">·</span>\n    <a href=\"#reviews\" class=\"pib-review-count\">194 reviews</a>\n  </div>\n\n  <!-- DIVIDER -->\n  <div class=\"pib-divider\"></div>\n\n  <!-- PRICE -->\n  <div class=\"pib-price-block\">\n    <div class=\"pib-price-row\">\n      <span class=\"pib-price-current\">{{ product.price | money }}</span>\n      <span class=\"pib-price-original\"><s>{{ product.price | times: 2 | money }}</s></span>\n      <span class=\"pib-price-badge\">50% OFF</span>\n    </div>\n    <div class=\"pib-price-note\">\n      🎉 You save <strong>{{ product.price | money }}</strong> today only\n    </div>\n  </div>\n\n  <!-- DIVIDER -->\n  <div class=\"pib-divider\"></div>\n\n  <!-- BULLETS -->\n  <ul class=\"pib-bullets\">\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>42 leadership principles kids can actually use</span>\n    </li>\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>Builds resilience, confidence &amp; critical thinking</span>\n    </li>\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>Comic-style illustrations kids read like a story</span>\n    </li>\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>28 timeless leadership lessons that stick for a lifetime</span>\n    </li>\n    <li class=\"pib-bullet\">\n      <span class=\"pib-check\" aria-hidden=\"true\">✔</span>\n      <span>Perfect for ages 8–12, 128 pages of colorful content</span>\n    </li>\n  </ul>\n\n</div>\n\n<style>\n\n  .pib-wrap *,\n  .pib-wrap *::before,\n  .pib-wrap *::after {\n    box-sizing: border-box;\n  }\n\n  .pib-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    color: #0d1b3e;\n    width: 100%;\n    max-width: 560px;\n  }\n\n  /* ─────────────────────────────\n     CAROUSEL\n  ───────────────────────────── */\n  .pib-carousel {\n    position: relative;\n    background: #ffffff;\n    border: 1px solid rgba(13,27,62,0.08);\n    border-radius: 14px;\n    padding: 22px 22px 16px;\n    margin-bottom: 22px;\n    overflow: hidden;\n    box-shadow:\n      0 1px 3px rgba(13,27,62,0.04),\n      0 4px 16px rgba(13,27,62,0.06);\n  }\n  .pib-carousel__bg-quote {\n    position: absolute;\n    top: -10px; right: 14px;\n    font-size: 100px;\n    font-family: Georgia, serif;\n    color: rgba(13,27,62,0.04);\n    line-height: 1;\n    pointer-events: none;\n    user-select: none;\n  }\n  .pib-slides { position: relative; min-height: 96px; }\n  .pib-slide { display: none; animation: pibFadeIn 0.5s ease; }\n  .pib-slide.active { display: block; }\n  @keyframes pibFadeIn {\n    from { opacity: 0; transform: translateY(6px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n  .pib-slide__text {\n    font-size: 14px; font-style: italic;\n    color: #1a1a2e; line-height: 1.65; margin: 0 0 14px 0;\n  }\n  .pib-slide__author { display: flex; align-items: center; gap: 10px; }\n  .pib-slide__avatar {\n    width: 36px; height: 36px; border-radius: 50%;\n    object-fit: cover; border: 2px solid rgba(13,27,62,0.08);\n    flex-shrink: 0; display: block;\n  }\n  .pib-slide__name {\n    font-size: 13px; font-weight: 800;\n    color: #0d1b3e; line-height: 1.2; margin-bottom: 3px;\n  }\n  .pib-slide__meta {\n    font-size: 11.5px; color: #9ca3af; font-weight: 500;\n    line-height: 1; display: flex; align-items: center;\n    gap: 4px; flex-wrap: wrap;\n  }\n  .pib-slide__stars { color: #f59e0b; font-size: 11px; letter-spacing: 1px; line-height: 1; }\n  .pib-dots { display: flex; gap: 6px; justify-content: center; margin-top: 14px; }\n  .pib-dot {\n    width: 7px; height: 7px; border-radius: 50%;\n    background: rgba(13,27,62,0.12); cursor: pointer;\n    transition: background 0.25s ease, transform 0.25s ease;\n    display: inline-block;\n  }\n  .pib-dot.active { background: #0d1b3e; transform: scale(1.35); }\n  .pib-dot:hover { background: rgba(13,27,62,0.3); }\n\n  /* ─────────────────────────────\n     SCARCITY\n  ───────────────────────────── */\n  .pib-scarcity {\n    display: inline-flex; align-items: center; gap: 8px;\n    background: #fff3cd; border: 1px solid #f5a623;\n    color: #92400e; border-radius: 8px; padding: 8px 14px;\n    font-size: 13px; font-weight: 700; margin-bottom: 18px; line-height: 1;\n  }\n  .pib-scarcity__pulse {\n    width: 8px; height: 8px; border-radius: 50%;\n    background: #c0392b; flex-shrink: 0; display: inline-block;\n    animation: pibPulse 1.8s ease-in-out infinite;\n  }\n  @keyframes pibPulse {\n    0%   { box-shadow: 0 0 0 0 rgba(192,57,43,0.5); }\n    70%  { box-shadow: 0 0 0 7px rgba(192,57,43,0); }\n    100% { box-shadow: 0 0 0 0 rgba(192,57,43,0); }\n  }\n\n  /* ─────────────────────────────\n     TITLE\n  ───────────────────────────── */\n  .pib-title {\n    font-size: clamp(21px, 3.5vw, 27px);\n    font-weight: 900;\n    line-height: 1.32;\n    letter-spacing: -0.5px;\n    color: #0d1b3e;\n    margin: 0 0 16px 0;\n  }\n  .pib-title__highlight {\n    display: inline-block;\n    background: #f5a623;\n    color: #0d1b3e;\n    border-radius: 6px;\n    padding: 2px 10px;\n    font-style: normal;\n    font-weight: 900;\n    font-size: 95%;\n    line-height: 1.4;\n  }\n  .pib-title em {\n    font-style: italic;\n    color: #c0392b;\n    font-weight: 400;\n  }\n\n  /* ─────────────────────────────\n     STARS\n  ───────────────────────────── */\n  .pib-stars-row {\n    display: flex; align-items: center;\n    gap: 7px; margin-bottom: 20px; flex-wrap: wrap;\n  }\n  .pib-stars { color: #f59e0b; font-size: 16px; letter-spacing: 1.5px; line-height: 1; }\n  .pib-rating-num { font-size: 13.5px; font-weight: 800; color: #0d1b3e; }\n  .pib-review-sep { color: #d1d5db; font-size: 13px; }\n  .pib-review-count {\n    font-size: 13px; color: #6b7280; font-weight: 600;\n    text-decoration: underline; text-underline-offset: 2px;\n    text-decoration-color: rgba(107,114,128,0.3); transition: color 0.15s ease;\n  }\n  .pib-review-count:hover { color: #0d1b3e; }\n\n  /* ─────────────────────────────\n     DIVIDER\n  ───────────────────────────── */\n  .pib-divider {\n    width: 100%; height: 1px;\n    background: rgba(13,27,62,0.07); margin: 4px 0 20px 0;\n  }\n\n  /* ─────────────────────────────\n     PRICE\n  ───────────────────────────── */\n  .pib-price-block { margin-bottom: 6px; }\n  .pib-price-row {\n    display: flex; align-items: center;\n    gap: 10px; flex-wrap: wrap; margin-bottom: 8px;\n  }\n  .pib-price-current {\n    font-size: clamp(36px, 7vw, 44px); font-weight: 900;\n    color: #c0392b; line-height: 1; letter-spacing: -2px;\n  }\n  .pib-price-original { line-height: 1; }\n  .pib-price-original s {\n    font-size: 17px; color: #9ca3af;\n    font-weight: 500; text-decoration-color: #9ca3af;\n  }\n  .pib-price-badge {\n    background: #c0392b; color: #fff; border-radius: 5px;\n    padding: 5px 10px; font-size: 12px; font-weight: 900;\n    text-transform: uppercase; letter-spacing: 0.07em;\n    line-height: 1; white-space: nowrap; align-self: center;\n  }\n  .pib-price-note {\n    display: flex; align-items: center; gap: 5px;\n    font-size: 13px; color: #6b7280; margin-bottom: 20px;\n  }\n  .pib-price-note strong { color: #0d1b3e; font-weight: 700; }\n\n  /* ─────────────────────────────\n     BULLETS\n  ───────────────────────────── */\n  .pib-bullets { list-style: none; padding: 0; margin: 0; }\n  .pib-bullet {\n    display: flex; align-items: flex-start; gap: 11px;\n    padding: 10px 0; border-bottom: 1px solid rgba(13,27,62,0.06);\n    font-size: clamp(14px, 2vw, 15px); color: #0d1b3e; line-height: 1.5;\n  }\n  .pib-bullet:last-child { border-bottom: none; }\n  .pib-check {\n    display: flex; align-items: center; justify-content: center;\n    width: 20px; height: 20px; min-width: 20px; border-radius: 50%;\n    background: #dcfce7; color: #166534; font-size: 10px;\n    font-weight: 900; flex-shrink: 0; margin-top: 1px; line-height: 1;\n  }\n\n  /* ─────────────────────────────\n     MOBILE\n  ───────────────────────────── */\n  @media (max-width: 480px) {\n    .pib-wrap { max-width: 100%; }\n    .pib-carousel { padding: 18px 16px 14px; }\n    .pib-carousel__bg-quote { font-size: 72px; right: 10px; }\n    .pib-title { font-size: 20px; }\n    .pib-title__highlight { padding: 2px 8px; }\n    .pib-price-current { letter-spacing: -1.5px; }\n    .pib-scarcity { font-size: 12.5px; padding: 7px 12px; }\n    .pib-bullet { font-size: 14px; padding: 9px 0; }\n    .pib-slide__avatar { width: 32px; height: 32px; }\n  }\n\n</style>\n\n<script>\n(function() {\n  var slides  = document.querySelectorAll('.pib-slide');\n  var dots    = document.querySelectorAll('.pib-dot');\n  var current = 0;\n  function goTo(idx) {\n    slides[current].classList.remove('active');\n    dots[current].classList.remove('active');\n    current = idx;\n    slides[current].classList.add('active');\n    dots[current].classList.add('active');\n  }\n\n  dots.forEach(function(dot) {\n    dot.addEventListener('click', function() {\n      goTo(parseInt(this.getAttribute('data-i')));\n    });\n  });\n})();\n</script>"
