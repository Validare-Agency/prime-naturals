    "custom_liquid_AwDERn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"inside-wrap\">\n\n  <div class=\"inside-header\">\n    <div class=\"inside-eyebrow\">\n      <span class=\"inside-eyebrow__dot\"></span>\n      Everything inside\n    </div>\n    <h2 class=\"inside-heading\">\n      One Book. <span class=\"inside-highlight\">Every Subject</span> They're Curious About.\n    </h2>\n    <p class=\"inside-sub\">\n      From the deepest ocean to the edge of the universe — if your child has wondered about it, the answer is in here.\n    </p>\n  </div>\n\n  <div class=\"inside-grid\">\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🚀</div>\n      <div class=\"inside-card__name\">Space & Universe</div>\n      <div class=\"inside-card__desc\">Black holes, planets, stars, rockets and life beyond Earth</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🦕</div>\n      <div class=\"inside-card__name\">Dinosaurs</div>\n      <div class=\"inside-card__desc\">Why they went extinct, how we find them, what they really looked like</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🧬</div>\n      <div class=\"inside-card__name\">The Human Body</div>\n      <div class=\"inside-card__desc\">Why your heart beats, how your brain works, why you dream</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🌊</div>\n      <div class=\"inside-card__name\">Oceans & Sea Life</div>\n      <div class=\"inside-card__desc\">Deep sea creatures, why the ocean is salty, how waves form</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">⚡</div>\n      <div class=\"inside-card__name\">Weather & Nature</div>\n      <div class=\"inside-card__desc\">Thunder, lightning, tornadoes, rainbows and the sky</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🏛️</div>\n      <div class=\"inside-card__name\">History & Civilisations</div>\n      <div class=\"inside-card__desc\">Ancient Egypt, the Romans, great inventions and how the world changed</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🦁</div>\n      <div class=\"inside-card__name\">Animals & Wildlife</div>\n      <div class=\"inside-card__desc\">How animals survive, migrate, communicate and why some go extinct</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🔬</div>\n      <div class=\"inside-card__name\">Science & Physics</div>\n      <div class=\"inside-card__desc\">Gravity, light, sound, electricity and how everything works</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🌿</div>\n      <div class=\"inside-card__name\">Plants & Biology</div>\n      <div class=\"inside-card__desc\">How plants grow, why leaves change colour, what makes things alive</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🧠</div>\n      <div class=\"inside-card__name\">The Brain & Mind</div>\n      <div class=\"inside-card__desc\">Memory, emotions, sleep, dreams and how the mind works</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">⚙️</div>\n      <div class=\"inside-card__name\">Technology & Inventions</div>\n      <div class=\"inside-card__desc\">How planes fly, how the internet works, what computers do</div>\n    </div>\n\n    <div class=\"inside-card\">\n      <div class=\"inside-card__icon\">🌍</div>\n      <div class=\"inside-card__name\">Earth & Geography</div>\n      <div class=\"inside-card__desc\">Volcanoes, earthquakes, tectonic plates and how Earth formed</div>\n    </div>\n\n  </div>\n\n</div>\n\n<style>\n\n  .inside-wrap *,\n  .inside-wrap *::before,\n  .inside-wrap *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* ── WRAP ── */\n  .inside-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    width: 100%;\n    background: #0d1b3e;\n    padding: 64px 20px;\n    color: #ffffff;\n  }\n\n  /* ── HEADER ── */\n  .inside-header {\n    text-align: center;\n    width: 100%;\n    max-width: 600px;\n    margin: 0 auto 44px;\n    padding: 0 4px;\n  }\n\n  .inside-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    background: rgba(245,166,35,0.15);\n    color: #f5a623;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    padding: 6px 13px;\n    border-radius: 100px;\n    margin-bottom: 16px;\n    line-height: 1;\n    border: 1px solid rgba(245,166,35,0.25);\n  }\n\n  .inside-eyebrow__dot {\n    width: 6px;\n    height: 6px;\n    min-width: 6px;\n    border-radius: 50%;\n    background: #f5a623;\n    flex-shrink: 0;\n    display: block;\n  }\n\n  .inside-heading {\n    font-size: clamp(21px, 4.5vw, 32px);\n    font-weight: 900;\n    line-height: 1.2;\n    letter-spacing: -0.5px;\n    color: #ffffff;\n    margin-bottom: 12px;\n    word-break: break-word;\n    hyphens: none;\n  }\n\n  .inside-highlight {\n    display: inline;\n    background: #f5a623;\n    color: #0d1b3e;\n    border-radius: 5px;\n    padding: 1px 7px;\n    font-weight: 900;\n    -webkit-box-decoration-break: clone;\n    box-decoration-break: clone;\n  }\n\n  .inside-sub {\n    font-size: clamp(13.5px, 2vw, 15.5px);\n    line-height: 1.72;\n    color: rgba(255,255,255,0.56);\n  }\n\n  /* ── GRID ── */\n  .inside-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 12px;\n    max-width: 1100px;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  /* ── CARD ── */\n  .inside-card {\n    background: rgba(255,255,255,0.05);\n    border: 1px solid rgba(255,255,255,0.08);\n    border-radius: 14px;\n    padding: 20px 16px;\n    transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;\n    cursor: default;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .inside-card:hover {\n    background: rgba(245,166,35,0.08);\n    border-color: rgba(245,166,35,0.3);\n    transform: translateY(-3px);\n  }\n\n  .inside-card__icon {\n    font-size: 26px;\n    line-height: 1;\n    margin-bottom: 11px;\n    display: block;\n    flex-shrink: 0;\n  }\n\n  .inside-card__name {\n    font-size: clamp(12px, 1.3vw, 14px);\n    font-weight: 800;\n    color: #ffffff;\n    line-height: 1.25;\n    margin-bottom: 6px;\n  }\n\n  .inside-card__desc {\n    font-size: clamp(11.5px, 1.1vw, 12.5px);\n    color: rgba(255,255,255,0.5);\n    line-height: 1.58;\n    font-weight: 500;\n  }\n\n  /* ── TABLET — 3 columns ── */\n  @media (max-width: 900px) {\n    .inside-wrap { padding: 56px 20px; }\n    .inside-grid { grid-template-columns: repeat(3, 1fr); gap: 11px; }\n    .inside-header { margin-bottom: 36px; }\n  }\n\n  /* ── MOBILE — 2 columns ── */\n  @media (max-width: 600px) {\n    .inside-wrap { padding: 48px 14px; }\n    .inside-grid { grid-template-columns: repeat(2, 1fr); gap: 9px; }\n    .inside-card { padding: 16px 13px; border-radius: 12px; }\n    .inside-card:hover { transform: none; }\n    .inside-card__icon { font-size: 22px; margin-bottom: 9px; }\n    .inside-card__name { font-size: 13px; margin-bottom: 5px; }\n    .inside-card__desc { font-size: 11.5px; line-height: 1.55; }\n    .inside-header { margin-bottom: 30px; padding: 0; }\n    .inside-eyebrow { font-size: 10px; padding: 5px 11px; gap: 6px; }\n    .inside-heading { font-size: 21px; letter-spacing: -0.3px; margin-bottom: 10px; }\n    .inside-sub { font-size: 13.5px; line-height: 1.68; }\n  }\n\n  /* ── TINY MOBILE — 320px ── */\n  @media (max-width: 360px) {\n    .inside-wrap { padding: 40px 12px; }\n    .inside-card { padding: 14px 11px; }\n    .inside-card__icon { font-size: 20px; }\n    .inside-card__name { font-size: 12px; }\n    .inside-card__desc { font-size: 11px; }\n    .inside-heading { font-size: 19px; }\n  }\n\n</style>",
