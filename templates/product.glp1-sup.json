    "custom_liquid_WdL3xd": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"cta-wrap\">\n\n  <div class=\"cta-inner\">\n\n    <div class=\"cta-eyebrow\">\n      <span class=\"cta-eyebrow__dot\"></span>\n      Sale Ends Tonight — 50% Off Today Only\n    </div>\n\n    <h2 class=\"cta-heading\">\n      Ready to Build Your Child's <em>Ultimate Brain?</em>\n    </h2>\n\n    <p class=\"cta-sub\">\n      Join 18,000+ families who made the decision. Free shipping. 30-day guarantee. No risk.\n    </p>\n\n    <button class=\"cta-btn\" id=\"cta-scroll-btn\">\n      <span class=\"cta-btn__icon\">🧠</span>\n      Get The Book — 50% Off\n      <span class=\"cta-btn__arrow\">→</span>\n    </button>\n\n    <div class=\"cta-trust\">\n      <div class=\"cta-trust__item\">\n        <span class=\"cta-trust__icon\">🛡️</span>\n        <span>30-Day Guarantee</span>\n      </div>\n      <div class=\"cta-trust__sep\">·</div>\n      <div class=\"cta-trust__item\">\n        <span class=\"cta-trust__icon\">📦</span>\n        <span>Free Shipping</span>\n      </div>\n      <div class=\"cta-trust__sep\">·</div>\n      <div class=\"cta-trust__item\">\n        <span class=\"cta-trust__icon\">🔒</span>\n        <span>Secure Checkout</span>\n      </div>\n    </div>\n\n  </div>\n\n</div>\n\n<style>\n\n  .cta-wrap *,\n  .cta-wrap *::before,\n  .cta-wrap *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  .cta-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    width: 100%;\n    background: #0d1b3e;\n    padding: 56px 16px;\n  }\n\n  .cta-inner {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    width: 100%;\n    max-width: 560px;\n    margin: 0 auto;\n  }\n\n  .cta-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    background: rgba(245,166,35,0.15);\n    border: 1px solid rgba(245,166,35,0.3);\n    color: #f5a623;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    padding: 6px 14px;\n    border-radius: 100px;\n    margin-bottom: 20px;\n    line-height: 1;\n  }\n\n  .cta-eyebrow__dot {\n    width: 6px;\n    height: 6px;\n    min-width: 6px;\n    border-radius: 50%;\n    background: #f5a623;\n    flex-shrink: 0;\n    display: block;\n    animation: ctaPulse 1.8s ease-in-out infinite;\n  }\n\n  @keyframes ctaPulse {\n    0%   { box-shadow: 0 0 0 0 rgba(245,166,35,0.6); }\n    70%  { box-shadow: 0 0 0 6px rgba(245,166,35,0); }\n    100% { box-shadow: 0 0 0 0 rgba(245,166,35,0); }\n  }\n\n  .cta-heading {\n    font-size: clamp(22px, 4vw, 32px);\n    font-weight: 900;\n    line-height: 1.18;\n    letter-spacing: -0.5px;\n    color: #ffffff;\n    margin-bottom: 14px;\n    word-break: break-word;\n    hyphens: none;\n  }\n\n  .cta-heading em {\n    font-style: italic;\n    color: #f5a623;\n    font-weight: 400;\n  }\n\n  .cta-sub {\n    font-size: clamp(13.5px, 1.8vw, 15px);\n    line-height: 1.7;\n    color: rgba(255,255,255,0.6);\n    margin-bottom: 32px;\n    max-width: 420px;\n    word-break: break-word;\n  }\n\n  .cta-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    background: #c0392b;\n    color: #ffffff;\n    border: none;\n    border-radius: 10px;\n    padding: 18px 32px;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    font-size: clamp(15px, 2vw, 17px);\n    font-weight: 800;\n    letter-spacing: 0.01em;\n    cursor: pointer;\n    margin-bottom: 24px;\n    width: 100%;\n    max-width: 380px;\n    box-shadow:\n      0 2px 8px rgba(192,57,43,0.3),\n      0 8px 24px rgba(192,57,43,0.25);\n    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;\n  }\n\n  .cta-btn:hover {\n    background: #a93226;\n    transform: translateY(-2px);\n    box-shadow:\n      0 4px 12px rgba(192,57,43,0.35),\n      0 14px 32px rgba(192,57,43,0.3);\n  }\n\n  .cta-btn:active {\n    transform: translateY(0);\n  }\n\n  .cta-btn__icon {\n    font-size: 20px;\n    line-height: 1;\n    flex-shrink: 0;\n  }\n\n  .cta-btn__arrow {\n    font-size: 18px;\n    line-height: 1;\n    flex-shrink: 0;\n    transition: transform 0.2s ease;\n  }\n\n  .cta-btn:hover .cta-btn__arrow {\n    transform: translateX(4px);\n  }\n\n  .cta-trust {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .cta-trust__item {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    font-size: 12px;\n    font-weight: 600;\n    color: rgba(255,255,255,0.45);\n    white-space: nowrap;\n  }\n\n  .cta-trust__icon {\n    font-size: 13px;\n    line-height: 1;\n  }\n\n  .cta-trust__sep {\n    color: rgba(255,255,255,0.2);\n    font-size: 12px;\n  }\n\n  @media (max-width: 480px) {\n    .cta-wrap { padding: 48px 16px; }\n    .cta-eyebrow { font-size: 10px; padding: 5px 12px; margin-bottom: 16px; }\n    .cta-heading { font-size: 22px; margin-bottom: 12px; }\n    .cta-sub { font-size: 13.5px; margin-bottom: 26px; }\n    .cta-btn { padding: 17px 24px; font-size: 15px; max-width: 100%; border-radius: 10px; }\n    .cta-trust { gap: 7px; }\n    .cta-trust__sep { display: none; }\n    .cta-trust__item { font-size: 11.5px; }\n  }\n\n  @media (max-width: 360px) {\n    .cta-wrap { padding: 40px 12px; }\n    .cta-heading { font-size: 20px; }\n    .cta-sub { font-size: 13px; }\n    .cta-btn { font-size: 14px; padding: 16px 20px; }\n  }\n\n</style>\n\n<script>\n(function() {\n  var btn = document.getElementById('cta-scroll-btn');\n  if (!btn) return;\n\n  btn.addEventListener('click', function() {\n\n    var target =\n      document.querySelector('.kaching-bundles') ||\n      document.querySelector('[data-kaching-bundles]') ||\n      document.querySelector('.kaching-bundle') ||\n      document.querySelector('[data-kaching]') ||\n      document.querySelector('.product-form') ||\n      document.querySelector('[data-product-form]') ||\n      document.querySelector('form[action*=\"/cart/add\"]') ||\n      document.querySelector('.product__form-wrapper') ||\n      document.querySelector('#product-form') ||\n      document.querySelector('.shopify-payment-button') ||\n      document.querySelector('[name=\"add\"]');\n\n    if (target) {\n      var offset = 80;\n      var top = target.getBoundingClientRect().top + window.pageYOffset - offset;\n      window.scrollTo({ top: top, behavior: 'smooth' });\n    } else {\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    }\n  });\n})();\n</script>",
