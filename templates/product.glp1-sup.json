    "custom_liquid_ycAyXQ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"stats-wrap\">\n\n  <div class=\"stats-inner\">\n\n    <div class=\"stats-header\">\n      <div class=\"stats-eyebrow\">\n        <span class=\"stats-eyebrow__dot\"></span>\n        The results speak for themselves\n      </div>\n      <h2 class=\"stats-heading\">Loved by <em>18,000+</em> Families Worldwide</h2>\n      <p class=\"stats-subhead\">Real parents. Real kids. Real results — tracked over 90 days.</p>\n    </div>\n\n    <div class=\"stats-grid\">\n\n      <div class=\"stats-card\">\n        <div class=\"stats-accent\"></div>\n        <div class=\"stats-pct\">94<span class=\"stats-sym\">%</span></div>\n        <p class=\"stats-desc\">of parents say their child's school performance improved within 60 days</p>\n        <div class=\"stats-divider\"></div>\n        <div class=\"stats-tag\">📈 School performance</div>\n      </div>\n\n      <div class=\"stats-card\">\n        <div class=\"stats-accent\"></div>\n        <div class=\"stats-pct\">97<span class=\"stats-sym\">%</span></div>\n        <p class=\"stats-desc\">of kids voluntarily picked up the book without being asked, after day 7</p>\n        <div class=\"stats-divider\"></div>\n        <div class=\"stats-tag\">📚 Voluntary reading</div>\n      </div>\n\n      <div class=\"stats-card\">\n        <div class=\"stats-accent\"></div>\n        <div class=\"stats-pct\">91<span class=\"stats-sym\">%</span></div>\n        <p class=\"stats-desc\">of parents said their child started asking deeper, more insightful questions</p>\n        <div class=\"stats-divider\"></div>\n        <div class=\"stats-tag\">🧠 Curiosity & thinking</div>\n      </div>\n\n    </div>\n\n    <p class=\"stats-footnote\">Results from a 90-day post-purchase survey of 1,200+ customers, December 2024 – February 2025.</p>\n\n  </div>\n\n</div>\n\n<style>\n\n  .stats-wrap *,\n  .stats-wrap *::before,\n  .stats-wrap *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* ── WRAP ── */\n  .stats-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    width: 100%;\n    padding: 48px 16px;\n    color: #0d1b3e;\n    background: transparent;\n  }\n\n  /* ── INNER ── */\n  .stats-inner {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    max-width: 600px;\n    margin: 0 auto;\n  }\n\n  /* ── HEADER ── */\n  .stats-header {\n    margin-bottom: 24px;\n  }\n\n  .stats-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    background: #dcfce7;\n    color: #166534;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    padding: 5px 13px;\n    border-radius: 100px;\n    margin-bottom: 14px;\n    line-height: 1;\n  }\n\n  .stats-eyebrow__dot {\n    width: 6px;\n    height: 6px;\n    min-width: 6px;\n    border-radius: 50%;\n    background: #166534;\n    flex-shrink: 0;\n    display: block;\n  }\n\n  .stats-heading {\n    font-size: clamp(20px, 3vw, 28px);\n    font-weight: 900;\n    line-height: 1.2;\n    letter-spacing: -0.4px;\n    color: #0d1b3e;\n    margin-bottom: 10px;\n    word-break: break-word;\n    hyphens: none;\n  }\n\n  .stats-heading em {\n    font-style: italic;\n    color: #c0392b;\n    font-weight: 900;\n  }\n\n  .stats-subhead {\n    font-size: clamp(13px, 1.6vw, 14.5px);\n    color: #6b7280;\n    line-height: 1.65;\n    font-weight: 500;\n    word-break: break-word;\n  }\n\n  /* ── GRID ── */\n  .stats-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin-bottom: 16px;\n    width: 100%;\n  }\n\n  /* ── CARD ── */\n  .stats-card {\n    position: relative;\n    background: #ffffff;\n    border: 1px solid rgba(13,27,62,0.07);\n    border-radius: 14px;\n    padding: 28px 20px 22px;\n    text-align: center;\n    overflow: hidden;\n    width: 100%;\n    box-shadow:\n      0 1px 3px rgba(13,27,62,0.05),\n      0 6px 20px rgba(13,27,62,0.07);\n    transition: transform 0.22s ease, box-shadow 0.22s ease;\n  }\n\n  .stats-card:hover {\n    transform: translateY(-2px);\n    box-shadow:\n      0 2px 6px rgba(13,27,62,0.07),\n      0 12px 32px rgba(13,27,62,0.11);\n  }\n\n  /* ── ACCENT ── */\n  .stats-accent {\n    position: absolute;\n    top: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 44px;\n    height: 3px;\n    background: #c0392b;\n    border-radius: 0 0 4px 4px;\n  }\n\n  /* ── NUMBER ── */\n  .stats-pct {\n    font-size: clamp(48px, 13vw, 62px);\n    font-weight: 900;\n    color: #0d1b3e;\n    line-height: 1;\n    letter-spacing: -3px;\n    margin-bottom: 10px;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    gap: 2px;\n  }\n\n  .stats-sym {\n    font-size: 50%;\n    font-weight: 900;\n    color: #c0392b;\n    margin-top: 8px;\n    letter-spacing: 0;\n    line-height: 1;\n  }\n\n  /* ── DESC ── */\n  .stats-desc {\n    font-size: clamp(13px, 1.6vw, 14.5px);\n    line-height: 1.65;\n    color: #6b7280;\n    margin: 0 auto 14px;\n    max-width: 100%;\n    word-break: break-word;\n  }\n\n  /* ── DIVIDER ── */\n  .stats-divider {\n    width: 36px;\n    height: 1px;\n    background: rgba(13,27,62,0.10);\n    margin: 0 auto 12px;\n  }\n\n  /* ── TAG ── */\n  .stats-tag {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: #f8f6f0;\n    border: 1px solid rgba(13,27,62,0.07);\n    border-radius: 100px;\n    padding: 5px 13px;\n    font-size: 12px;\n    font-weight: 700;\n    color: #0d1b3e;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  /* ── FOOTNOTE ── */\n  .stats-footnote {\n    font-size: 11px;\n    color: #b0b7c3;\n    line-height: 1.65;\n    letter-spacing: 0.01em;\n    word-break: break-word;\n  }\n\n  /* ── MOBILE ── */\n  @media (max-width: 480px) {\n    .stats-wrap { padding: 36px 16px; }\n    .stats-header { margin-bottom: 20px; }\n    .stats-card {\n      padding: 24px 16px 20px;\n      border-radius: 12px;\n    }\n    .stats-card:hover { transform: none; }\n    .stats-pct {\n      font-size: clamp(44px, 12vw, 54px);\n      letter-spacing: -2px;\n      margin-bottom: 9px;\n    }\n    .stats-desc { font-size: 13px; margin-bottom: 12px; }\n    .stats-tag { font-size: 11.5px; padding: 4px 11px; }\n    .stats-grid { gap: 9px; }\n    .stats-footnote { font-size: 10.5px; }\n  }\n\n  /* ── TINY MOBILE ── */\n  @media (max-width: 360px) {\n    .stats-wrap { padding: 32px 12px; }\n    .stats-card { padding: 22px 12px 18px; }\n    .stats-pct { font-size: 42px; letter-spacing: -1.5px; }\n    .stats-desc { font-size: 12.5px; }\n    .stats-tag { font-size: 11px; padding: 4px 10px; }\n  }\n\n</style>",
