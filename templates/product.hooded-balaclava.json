;\n    transition: transform 0.22s ease, box-shadow 0.22s ease;\n  }\n  .rev-card:hover {\n    transform: translateY(-2px);\n    box-shadow:\n      0 2px 6px rgba(13, 27, 62, 0.07),\n      0 10px 28px rgba(13, 27, 62, 0.10);\n  }\n\n  \/* ── STARS ── *\/\n  .rev-stars {\n    color: #f59e0b;\n    font-size: 17px;\n    letter-spacing: 2px;\n    margin-bottom: 14px;\n    line-height: 1;\n  }\n\n  \/* ── REVIEW TEXT ── *\/\n  .rev-text {\n    font-size: clamp(13.5px, 2.2vw, 15px);\n    line-height: 1.75;\n    color: #1a1a2e;\n    font-style: italic;\n    margin: 0 0 20px 0;\n    position: relative;\n  }\n\n  \/* ── AUTHOR ROW ── *\/\n  .rev-author {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding-top: 18px;\n    border-top: 1px solid rgba(13, 27, 62, 0.07);\n  }\n\n  .rev-avatar {\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    background: #f3f4f6;\n    border: 1px solid rgba(13, 27, 62, 0.08);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    flex-shrink: 0;\n  }\n\n  .rev-author-info {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n  }\n\n  .rev-name {\n    font-size: 14px;\n    font-weight: 800;\n    color: #0d1b3e;\n    line-height: 1;\n  }\n\n  .rev-meta {\n    font-size: 12.5px;\n    color: #9ca3af;\n    font-weight: 500;\n    line-height: 1;\n  }\n\n  .rev-verified {\n    color: #166534;\n    font-weight: 700;\n  }\n\n  \/* ── MOBILE ── *\/\n  @media (max-width: 480px) {\n    .rev-card {\n      padding: 22px 18px 20px;\n      border-radius: 14px;\n    }\n    .rev-stars {\n      font-size: 15px;\n    }\n    .rev-avatar {\n      width: 38px;\n      height: 38px;\n      font-size: 18px;\n    }\n    .rev-name {\n      font-size: 13.5px;\n    }\n    .rev-meta {\n      font-size: 12px;\n    }\n  }\n<\/style>","color_scheme":"background-1","padding_top":40,"padding_bottom":52}},"related-products":{"type":"related-products","disabled":true,"settings":{"dis