tage":0,"mobile_scroll_padding_pixels":0,"enable_mobile_outher_spacing":false,"mobile_slides_container_width":100,"mobile_slides_inner_width":100,"trust_badge_position":"top-right","trust_badge_size":"medium","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36}},"custom_liquid_4hfNHc":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<div class=\"fail-wrap\">\n\n  <h2 class=\"fail-heading\">Why Regular Children's Books <em>Fail<\/em> at Building Smart Kids<\/h2>\n\n  <div class=\"fail-list\">\n\n    <div class=\"fail-item\">\n      <h3>1. They Tell, Not Teach<\/h3>\n      <p>Most children's books say \"the sky is blue\" but never explain WHY. Children memorize facts but build no understanding. First time a classmate challenges it? No defense.<\/p>\n    <\/div>\n\n    <div class=\"fail-item\">\n      <h3>2. One Topic, One Book<\/h3>\n      <p>Standard books cover one narrow subject. Your child's brain is hungry for connections across science, history, nature, and technology — connections most books never make.<\/p>\n    <\/div>\n\n    <div class=\"fail-item\">\n      <h3>3. Written for Adults, Not Kids<\/h3>\n      <p>Most encyclopedias are dense, dry reference tools. Kids read two pages and put them down. The content exists — but it never lands because the format kills curiosity.<\/p>\n    <\/div>\n\n    <div class=\"fail-item\">\n      <h3>4. Answers Questions Nobody Asked<\/h3>\n      <p>Generic content covers what curricula dictate, not what kids actually wonder about. Real curiosity gets ignored — and a child who stops asking questions stops thinking.<\/p>\n    <\/div>\n\n    <div class=\"fail-item\">\n      <h3>5. Screens Win Every Time<\/h3>\n      <p>Books designed without engagement in mind lose to YouTube every single night. If reading doesn't feel like discovery, kids choose the device — every parent knows this.<\/p>\n    <\/div>\n\n  <\/div>\n\n  <div class=\"fail-result\">\n    <p>The result? Kids who know <em>what<\/em> adults tell them — but not <em>why<\/em> any of it is true. Kids who score fine on tests but never think for themselves. Kids whose curiosity slowly dies.<\/p>\n    <strong>Regular books teach content. \"Why 100,000?\" builds minds.<\/strong>\n  <\/div>\n\n<\/div>\n\n<style>\n  .fail-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    width: 100%;\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 16px;\n    box-sizing: border-box;\n    color: #0d1b3e;\n  }\n\n  .fail-heading {\n    font-size: clamp(20px, 4vw, 28px);\n    font-weight: 900;\n    line-height: 1.2;\n    letter-spacing: -0.4px;\n    color: #0d1b3e;\n    margin: 0 0 20px 0;\n  }\n  .fail-heading em {\n    font-style: italic;\n    color: #c0392b;\n    font-weight: 400;\n  }\n\n  .fail-list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .fail-item {\n    padding: 18px 18px 18px 20px;\n    border-left: 3px solid #c0392b;\n    background: #fff;\n    border-radius: 0 8px 8px 0;\n    box-shadow: 0 1px 4px rgba(13,27,62,0.06);\n    box-sizing: border-box;\n  }\n\n  .fail-item h3 {\n    font-size: clamp(14px, 2.5vw, 15px);\n    font-weight: 800;\n    color: #0d1b3e;\n    margin: 0 0 6px 0;\n    line-height: 1.3;\n  }\n\n  .fail-item p {\n    font-size: clamp(13px, 2vw, 14px);\n    line-height: 1.65;\n    color: #6b7280;\n    margin: 0;\n  }\n\n  .fail-result {\n    background: #0d1b3e;\n    border-radius: 10px;\n    padding: clamp(20px, 4vw, 32px);\n    margin-top: 20px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  .fail-result p {\n    font-size: clamp(13px, 2.5vw, 15px);\n    line-height: 1.75;\n    color: rgba(255,255,255,0.8);\n    margin: 0 0 14px 0;\n  }\n\n  .fail-result em {\n    font-style: italic;\n    color: #fff;\n    font-weight: 600;\n  }\n\n  .fail-result strong {\n    display: block;\n    font-size: clamp(13px, 2.5vw, 15px);\n    font-weight: 800;\n    color: #f5a623;\n    line-height: 1.5;\n  }\n\n  @media (max-width: 480px) {\n    .fail-wrap {\n      padding: 0 4px;\n    }\n    .fail-item {\n      padding: 16px 14px 16px 16px;\n    }\n    .fail-result {\n      padding: 22px 18px;\n    }\n  }\n<\/style>","color_scheme":"background-1","padding_top":40,"padding_bottom":52}},"custom_liquid_QM3LUq":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<div class=\"stats-wrap\">\n\n  <h2 class=\"stats-heading\">Loved by <em>18,000+<\/em> Families Worldwide<\/h2>\n\n  <div class=\"stats-grid\">\n\n    <div class=\"stats-card\">\n      <div class=\"stats-accent\"><\/div>\n      <div class=\"stats-pct\">94<span class=\"stats-sym\">%<\/span><\/div>\n      <p class=\"stats-desc\">of parents say their child's school performance improved within 60 days<\/p>\n    <\/div>\n\n    <div class=\"stats-card\">\n      <div class=\"stats-accent\"><\/div>\n      <div class=\"stats-pct\">97<span class=\"stats-sym\">%<\/span><\/div>\n      <p class=\"stats-desc\">of kids voluntarily picked up the book without being asked, after day 7<\/p>\n    <\/div>\n\n    <div class=\"stats-card\">\n      <div class=\"stats-accent\"><\/div>\n      <div class=\"stats-pct\">91<span class=\"stats-sym\">%<\/span><\/div>\n      <p class=\"stats-desc\">of parents said their child started asking deeper, more insightful questions<\/p>\n    <\/div>\n\n  <\/div>\n\n  <p class=\"stats-footnote\">\n    Results from a 90-day post-purchase survey of 1,200+ customers, December 2024 – February 2025.\n  <\/p>\n\n<\/div>\n\n<style>\n  .stats-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    width: 100%;\n    max-width: 640px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    color: #0d1b3e;\n  }\n\n  \/* ── HEADING ── *\/\n  .stats-heading {\n    font-size: clamp(21px, 4.5vw, 28px);\n    font-weight: 900;\n    line-height: 1.18;\n    letter-spacing: -0.5px;\n    color: #0d1b3e;\n    margin: 0 0 24px 0;\n  }\n  .stats-heading em {\n    font-style: italic;\n    color: #c0392b;\n    font-weight: 900;\n  }\n\n  \/* ── GRID ── *\/\n  .stats-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    margin-bottom: 20px;\n  }\n\n  \/* ── CARD ── *\/\n  .stats-card {\n    position: relative;\n    background: #ffffff;\n    border: 1px solid rgba(13, 27, 62, 0.07);\n    border-radius: 16px;\n    padding: 36px 32px 32px;\n    text-align: center;\n    box-sizing: border-box;\n    overflow: hidden;\n    box-shadow:\n      0 1px 3px rgba(13, 27, 62, 0.05),\n      0 6px 20px rgba(13, 27, 62, 0.07);\n    transition: transform 0.22s ease, box-shadow 0.22s ease;\n  }\n  .stats-card:hover {\n    transform: translateY(-3px);\n    box-shadow:\n      0 2px 6px rgba(13, 27, 62, 0.07),\n      0 12px 32px rgba(13, 27, 62, 0.11);\n  }\n\n  \/* subtle top accent line *\/\n  .stats-accent {\n    position: absolute;\n    top: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 48px;\n    height: 3px;\n    background: #c0392b;\n    border-radius: 0 0 4px 4px;\n  }\n\n  \/* ── BIG NUMBER ── *\/\n  .stats-pct {\n    font-size: clamp(58px, 12vw, 72px);\n    font-weight: 900;\n    color: #0d1b3e;\n    line-height: 1;\n    letter-spacing: -3px;\n    margin-bottom: 14px;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    gap: 2px;\n  }\n  .stats-sym {\n    font-size: 52%;\n    font-weight: 900;\n    color: #c0392b;\n    margin-top: 8px;\n    letter-spacing: 0;\n  }\n\n  \/* ── DESCRIPTION ── *\/\n  .stats-desc {\n    font-size: clamp(13.5px, 2.2vw, 15px);\n    line-height: 1.65;\n    color: #6b7280;\n    margin: 0 auto;\n    max-width: 300px;\n  }\n\n  \/* ── FOOTNOTE ── *\/\n  .stats-footnote {\n    font-size: 11.5px;\n    color: #b0b7c3;\n    text-align: center;\n    line-height: 1.65;\n    margin: 0;\n    letter-spacing: 0.01em;\n  }\n\n  \/* ── MOBILE ── *\/\n  @media (max-width: 480px) {\n    .stats-card {\n      padding: 30px 20px 26px;\n      border-radius: 14px;\n    }\n    .stats-pct {\n      letter-spacing: -2px;\n    }\n    .stats-desc {\n      max-width: 100%;\n    }\n    .stats-footnote {\n      font-size: 11px;\n    }\n  }\n<\/style>","color_scheme":"background-1","padding_top":40,"padding_bottom":52}},"custom_liquid_yigUDq":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<div class=\"rev-wrap\">\n\n  <h2 class=\"rev-heading\">What Parents Are <em>Saying<\/em><\/h2>\n\n  <div class=\"rev-list\">\n\n    <div class=\"rev-card\">\n      <div class=\"rev-stars\">★★★★★<\/div>\n      <p class=\"rev-text\">\"My 9-year-old asked me 'Mom, why do we have two eyes instead of one?' I didn't know the answer. He went straight to this book, found it, and then spent 45 minutes reading about vision, brains, and evolution. He came back and explained it to me. I almost cried. His teacher called two weeks later to say he was the most engaged student in class.\"<\/p>\n      <div class=\"rev-author\">\n        <div class=\"rev-avatar\">👩<\/div>\n        <div class=\"rev-author-info\">\n          <span class=\"rev-name\">Rachel M.<\/span>\n          <span class=\"rev-meta\">Mom of two · Texas · <span class=\"rev-verified\">✔ Verified buyer<\/span><\/span>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"rev-card\">\n      <div class=\"rev-stars\">★★★★★<\/div>\n      <p class=\"rev-text\">\"I was skeptical. My son doesn't read. He's a screen kid. I put this on the coffee table and didn't say a word. Day 3, I found him on the floor reading about black holes at 9pm when I thought he was asleep. He's read it cover to cover twice. That is not a normal thing for him. Buy it — it competes with screens.\"<\/p>\n      <div class=\"rev-author\">\n        <div clas