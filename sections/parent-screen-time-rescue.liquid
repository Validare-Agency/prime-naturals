<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Inter:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'sticky-cta.css' | asset_url }}">
<script src="{{ 'sticky-cta.js' | asset_url }}" defer></script>

<style>
.shopify-section-group-header-group,
.shopify-section-group-footer-group,
#header-group,
#footer-group,
.announcement-bar-section { display: none !important; }

.pn-pstr *,
.pn-pstr *::before,
.pn-pstr *::after { box-sizing: border-box; margin: 0; padding: 0; }

.pn-pstr {
  font-family: 'Inter', sans-serif;
  color: #1d2333;
  background: #fff;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  gap: 40px;
}

/* ── Layout helpers ── */
.pn-pstr .wrap {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
  width: 100%;
}
.pn-pstr .wrap-wide {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── CTA Button ── */
.pn-pstr .cta-btn {
  display: inline-block;
  background: #e14b3c;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  font-size: 20px;
  letter-spacing: 0.2px;
  text-decoration: none;
  padding: 19px 32px;
  border-radius: 10px;
  text-align: center;
  line-height: 1.4;
  transition: opacity 0.2s;
}
.pn-pstr .cta-btn:hover { opacity: 0.9; }

/* ═══════════════════════════════════
   SECTION 1 — HERO
═══════════════════════════════════ */
.pn-pstr .hero {
  padding: 56px 0 0;
}
.pn-pstr .hero-eyebrow {
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  font-size: 15px;
  color: #2e8b4f;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 14px;
}
.pn-pstr .hero-h1 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 46px;
  line-height: 1.18;
  color: #14213d;
  margin-bottom: 16px;
}
.pn-pstr .hero-sub {
  font-size: 23px;
  line-height: 1.68;
  color: #5b6072;
  margin-bottom: 24px;
}
.pn-pstr .hero-cta-wrap {
  margin-bottom: 32px;
}

/* ── Hero image area (main + overlay) ── */
.pn-pstr .hero-img-wrap {
  position: relative;
  width: 100%;
  border-radius: 12px;
  overflow: visible;
  margin-bottom: 0;
}
.pn-pstr .hero-img-main {
  width: 100%;
  display: block;
  border-radius: 12px;
}
.pn-pstr .hero-img-overlay {
  position: absolute;
  bottom: -4%;
  right: 0;
  width: 28%;
  border-radius: 8px;
}

/* ═══════════════════════════════════
   SECTION 2 — SCREEN TIME HARM CARD
═══════════════════════════════════ */
.pn-pstr .harm-card {
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  padding: 32px 20px 28px;
  margin: 0 0 32px;
  text-align: center;
}
.pn-pstr .harm-card-books {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 12px;
  margin-bottom: 24px;
}
.pn-pstr .harm-book-large {
  width: 220px;
  height: 142px;
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.pn-pstr .harm-book-large img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pn-pstr .harm-heading {
  font-weight: 700;
  font-size: 22px;
  line-height: 1.36;
  color: #000;
  margin-bottom: 24px;
}
.pn-pstr .harm-icons-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px 24px;
  max-width: 480px;
  margin: 0 auto;
  text-align: left;
}
.pn-pstr .harm-icon-item {
  display: flex;
  align-items: center;
  gap: 10px;
}
.pn-pstr .harm-icon-item img {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: block;
}
.pn-pstr .harm-icon-label {
  font-size: 18px;
  color: #000;
  white-space: nowrap;
}

/* ═══════════════════════════════════
   SECTION 3 — TRANSITION + QUOTE
═══════════════════════════════════ */
.pn-pstr .transition-para {
  font-size: 23px;
  font-weight: 600;
  line-height: 1.35;
  color: #1d2333;
  text-align: center;
  margin: 0 0 32px;
}
.pn-pstr .quote-card {
  background: #f6f7fa;
  border-radius: 14px;
  padding: 26px 28px;
  display: flex;
  align-items: flex-start;
  gap: 22px;
}
.pn-pstr .quote-avatar {
  width: 120px;
  height: 120px;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}
.pn-pstr .quote-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pn-pstr .quote-body {}
.pn-pstr .quote-text {
  font-size: 20px;
  font-style: italic;
  line-height: 1.5;
  color: #1d2333;
  margin-bottom: 10px;
}
.pn-pstr .quote-text strong { color: #e14b3c; font-style: italic; }
.pn-pstr .quote-attribution {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 16px;
  color: #14213d;
}

/* ═══════════════════════════════════
   SECTION 4 — TOPIC INTRO + COMIC
═══════════════════════════════════ */
.pn-pstr .section-italic-intro {
  font-size: 17px;
  font-style: italic;
  color: #5b6072;
  text-align: center;
  margin-bottom: 8px;
}
.pn-pstr .section-h2 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 33px;
  color: #14213d;
  text-align: center;
  line-height: 1.3;
  margin-bottom: 24px;
}
.pn-pstr .comic-img-wrap {
  width: 100%;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 32px;
}
.pn-pstr .comic-img-wrap img {
  width: 100%;
  height: auto;
  display: block;
}

/* ═══════════════════════════════════
   SECTION 5 — TOPIC EXAMPLES
═══════════════════════════════════ */
.pn-pstr .topic-example {
  margin-bottom: 42px;
}
.pn-pstr .topic-example:last-child {
  margin-bottom: 0;
}
.pn-pstr .topic-example-label {
  font-weight: 800;
  font-size: 15px;
  color: #e14b3c;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  margin-bottom: 4px;
}
.pn-pstr .topic-example-h3 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 28px;
  color: #14213d;
  line-height: 1.21;
  margin-bottom: 12px;
}
.pn-pstr .topic-example-p {
  font-size: 25px;
  line-height: 1.41;
  color: #1d2333;
  margin-bottom: 14px;
}
.pn-pstr .topic-highlight {
  background: #eaf6ec;
  border-radius: 10px;
  padding: 14px 18px;
  font-weight: 700;
  font-size: 22px;
  line-height: 1.38;
  color: #1f5c33;
}

/* ═══════════════════════════════════
   SECTION 6 — SOCIAL PROOF
═══════════════════════════════════ */
.pn-pstr .social-proof-wrap {
  position: relative;
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 716 / 400;
  margin-bottom: 8px;
}
.pn-pstr .social-proof-wrap img.sp-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.pn-pstr .social-proof-wrap img.sp-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.pn-pstr .sp-badge-families {
  position: absolute;
  bottom: 8px;
  left: 8px;
  background: #fff;
  border: 1px solid #e0d0c0;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 13px;
  white-space: nowrap;
}
.pn-pstr .sp-badge-families .badge-emoji { font-size: 20px; }
.pn-pstr .sp-badge-families .badge-text-title {
  font-weight: 700;
  font-size: 15px;
  color: #1a1a1a;
  letter-spacing: -0.3px;
}
.pn-pstr .sp-badge-bestseller {
  position: absolute;
  top: 8px;
  right: 8px;
  background: #166534;
  color: #fff;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: -0.3px;
  border-radius: 10px;
  padding: 10px 13px;
  white-space: nowrap;
}

.pn-pstr .sp-cta-wrap {
  display: flex;
  justify-content: center;
  padding: 32px 0 0;
}

/* ═══════════════════════════════════
   SECTION 8 — REACTION / TESTIMONIALS
═══════════════════════════════════ */
.pn-pstr .section-divider {
  height: 1px;
  background: #e6e8ec;
  margin: 40px 0;
  display: block;
}
.pn-pstr .testimonials-section .wrap > .section-divider:first-child {
  margin-top: 0;
}
.pn-pstr .testimonials-h2 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 33px;
  color: #14213d;
  text-align: center;
  margin-bottom: 32px;
}
.pn-pstr .reaction-img-wrap {
  background: #fff3e8;
  border-radius: 14px;
  overflow: hidden;
  width: 100%;
  max-width: 710px;
  margin: 0 auto 40px;
  aspect-ratio: 1512 / 2016;
  position: relative;
}
.pn-pstr .reaction-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pn-pstr .reviews-headline-wrap {
  text-align: center;
  margin-bottom: 32px;
}
.pn-pstr .reviews-headline {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 35px;
  color: #14213d;
  line-height: 1.4;
}
.pn-pstr .reviews-headline span { color: #c0392b; }
.pn-pstr .reviews-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  max-width: 760px;
  margin: 0 auto;
}
.pn-pstr .review-card {
  background: #fff;
  border: 1px solid #e6e8ec;
  border-radius: 10px;
  padding: 23px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.pn-pstr .review-stars {
  color: #f5a623;
  font-size: 18px;
  letter-spacing: 1px;
}
.pn-pstr .review-text {
  font-size: 19px;
  line-height: 32px;
  color: #1d2333;
  flex: 1;
}
.pn-pstr .review-author {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 6px;
}
.pn-pstr .review-avatar {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.pn-pstr .review-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pn-pstr .review-name {
  font-weight: 700;
  font-size: 17px;
  color: #1d2333;
}
.pn-pstr .review-role {
  font-size: 15px;
  color: #5b6072;
}
.pn-pstr .review-verified {
  font-weight: 700;
  font-size: 15px;
  color: #2e8b4f;
}

/* ═══════════════════════════════════
   SECTION 9 — OFFER CARD
═══════════════════════════════════ */
/* ── Footer ── */
.pn-pstr .pn-footer {
  background: #e14b3c;
  padding: 20px;
  text-align: center;
}
.pn-pstr .pn-footer p {
  font-size: 14px;
  color: #fff;
  line-height: 1.68;
}

/* ═══════════════════════════════════
   MOBILE STYLES (≤749px)
═══════════════════════════════════ */
@media (max-width: 749px) {
  .pn-pstr { gap: 24px; }
  .pn-pstr .hero { padding: 28px 0 0; }
  .pn-pstr .hero-h1 { font-size: 26px; }
  .pn-pstr .hero-sub { font-size: 16px; }
  .pn-pstr .hero-eyebrow { font-size: 11px; letter-spacing: 1.2px; }
  .pn-pstr .cta-btn { width: 100%; font-size: 14px; padding: 15px 20px; }

  .pn-pstr .harm-card { padding: 20px 14px 18px; }
  .pn-pstr .harm-heading { font-size: 17px; }
  .pn-pstr .harm-icon-label { font-size: 14px; }
  .pn-pstr .harm-icon-item img { width: 36px; height: 36px; }

  .pn-pstr .quote-card { flex-direction: column; gap: 16px; padding: 20px; }
  .pn-pstr .quote-avatar { width: 80px; height: 80px; }
  .pn-pstr .quote-text { font-size: 15.5px; }
  .pn-pstr .transition-para { font-size: 16px; }

  .pn-pstr .section-h2 { font-size: 22px; }
  .pn-pstr .topic-example-p { font-size: 16px; }
  .pn-pstr .topic-example-h3 { font-size: 20px; }
  .pn-pstr .topic-highlight { font-size: 15px; }

  .pn-pstr .sp-badge-families { bottom: 6%; left: 2%; font-size: 9px; gap: 5px; padding: 5px 7px; }
  .pn-pstr .sp-badge-families .badge-emoji { font-size: 11px; }
  .pn-pstr .sp-badge-families .badge-text-title { font-size: 9.5px; }
  .pn-pstr .sp-badge-bestseller { font-size: 9.5px; padding: 5px 7px; border-radius: 6px; }

  .pn-pstr .testimonials-h2 { font-size: 24px; }
  .pn-pstr .reviews-headline { font-size: 22px; }
  .pn-pstr .reviews-grid { grid-template-columns: 1fr; }
}
</style>

<div class="pn-pstr">

  {%- comment -%} ═══ HERO ═══ {%- endcomment -%}
  <section class="hero">
    <div class="wrap">
      <p class="hero-eyebrow">👀 The Book From the Video You Just Watched</p>
      <h1 class="hero-h1">The First Thing They've Picked Over the Tablet</h1>
      <p class="hero-sub">Hundreds of questions, drawn like a comic. The rare thing a kid chooses on their own, instead of a screen.</p>
      <div class="hero-cta-wrap" data-sticky-cta-bar>
        <a href="{{ section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys' }}" class="cta-btn">GET 50% OFF ON THE BOOK →</a>
      </div>

      <div class="hero-img-wrap">
        <img class="hero-img-main" src="{{ 'pstr-hero-book.png' | asset_url }}" alt="10,000 Whys Kids' Encyclopedia — comic-style illustration spread" width="712" height="398" loading="eager">
      </div>
    </div>
  </section>

  {%- comment -%} ═══ SCREEN TIME HARM CARD ═══ {%- endcomment -%}
  <div class="wrap">
    <div class="harm-card">
      <div class="harm-card-books">
        <div class="harm-book-large">
          <img src="{{ 'pstr-book-spread.png' | asset_url }}" alt="Book spread illustration" width="96" height="142" loading="lazy">
        </div>
      </div>
      <p class="harm-heading">Excessive screen time can damage kid's brain power.</p>
      <div class="harm-icons-grid">
        <div class="harm-icon-item">
          <img src="{{ 'pstr-icon-sleep.svg' | asset_url }}" alt="" width="48" height="48" loading="lazy" aria-hidden="true">
          <span class="harm-icon-label">Sleep loss</span>
        </div>
        <div class="harm-icon-item">
          <img src="{{ 'pstr-icon-memory.svg' | asset_url }}" alt="" width="48" height="48" loading="lazy" aria-hidden="true">
          <span class="harm-icon-label">Poor memory</span>
        </div>
        <div class="harm-icon-item">
          <img src="{{ 'pstr-icon-social.svg' | asset_url }}" alt="" width="48" height="48" loading="lazy" aria-hidden="true">
          <span class="harm-icon-label">Weak social skills</span>
        </div>
        <div class="harm-icon-item">
          <img src="{{ 'pstr-icon-attention.svg' | asset_url }}" alt="" width="48" height="48" loading="lazy" aria-hidden="true">
          <span class="harm-icon-label">Short attention span</span>
        </div>
      </div>
    </div>

    <p class="transition-para">You already know the tablet is winning. The trick isn't taking it away, it's putting something in reach that's actually more interesting. For a lot of kids, this is that thing.</p>

    {%- comment -%} Pull quote ─────────────────── {%- endcomment -%}
    <div class="quote-card">
      <div class="quote-avatar">
        <img src="{{ 'pstr-quote-avatar.png' | asset_url }}" alt="A parent sharing their experience" width="120" height="120" loading="lazy">
      </div>
      <div class="quote-body">
        <p class="quote-text">"When my grandkids asked me why the sky was blue, I realized I didn't actually know. So I found the book that did, and now <strong>they</strong> tell <strong>me</strong>. That's the whole point. Hundreds of questions, every answer drawn like a comic."</p>
        <p class="quote-attribution">— Why parents are switching to 10,000 Why</p>
      </div>
    </div>
  </div>

  {%- comment -%} ═══ TOPIC INTRO + COMIC ═══ {%- endcomment -%}
  <div class="wrap">
    <p class="section-italic-intro">Here's why they choose it over the screen.</p>
    <h2 class="section-h2">Not a Textbook. A Comic They Can't Put Down.</h2>

    <div class="comic-img-wrap">
      <img src="{{ 'magnific_4second-loop-grandmothers.gif' | asset_url }}" alt="Comic-style pages from 10,000 Whys encyclopedia" width="712" height="382" loading="lazy">
    </div>

    {%- comment -%} Topic Examples ─────────────────── {%- endcomment -%}
    <div class="topic-example">
      <p class="topic-example-label">🔥 Physics · page 42</p>
      <h3 class="topic-example-h3">Why Can Water Put Out a Fire?</h3>
      <p class="topic-example-p">A grinning cartoon firefighter, a panicking flame, and an answer they'll repeat at dinner for a week. There's even a "You know what?" box with a fact most adults get wrong. We'll let them tell you that one.</p>
      <div class="topic-highlight">Every page ends with a "You know what?" box, the fact that makes them say it out loud.</div>
    </div>

    <div class="topic-example">
      <p class="topic-example-label">⚡ Everyday Safety · page 57</p>
      <h3 class="topic-example-h3">Why Shouldn't You Touch a Plug With Wet Hands?</h3>
      <p class="topic-example-p">This one has a cartoon pig getting the shock of its life, and a real, kid-level explanation of why it happens. Much better learned from a funny drawing than the hard way.</p>
      <div class="topic-highlight">Real safety, real science, delivered so it actually sticks.</div>
    </div>

    <div class="topic-example">
      <p class="topic-example-label">🌸 Biology · early chapters</p>
      <h3 class="topic-example-h3">Why Do Flowers Have a Fragrance?</h3>
      <p class="topic-example-p">Turns out a flower's smell is basically an advertisement aimed at bees. One question, and suddenly they understand pollination, seeds, and fruit, without ever feeling like a lesson.</p>
      <div class="topic-highlight">One question quietly teaches five things. And there are hundreds more.</div>
    </div>
  </div>

  {%- comment -%} ═══ SOCIAL PROOF IMAGE ═══ {%- endcomment -%}
  <div class="wrap">
    <div class="social-proof-wrap">
      <img class="sp-bg" src="{{ 'social-proof.png' | asset_url }}" alt="Family enjoying the book in a cozy living room" width="716" height="400" loading="lazy">
    </div>
    <div class="sp-cta-wrap" data-sticky-cta-bar>
      <a href="{{ section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys' }}" class="cta-btn">GET 50% OFF ON THE BOOK →</a>
    </div>
  </div>

  {%- comment -%} ═══ TOPICS GRID ═══ {%- endcomment -%}
  {%- render 'topics-grid' -%}

  {%- comment -%} ═══ TESTIMONIALS ═══ {%- endcomment -%}
  <section class="testimonials-section">
    <div class="wrap">

      <div class="section-divider"></div>
      <h2 class="testimonials-h2">See Their Reaction</h2>

      <div class="reaction-img-wrap">
        <img src="{{ 'pstr-reaction.png' | asset_url }}" alt="Child's delighted reaction reading the book" width="480" height="640" loading="lazy">
      </div>

      <div class="section-divider"></div>

      <div class="reviews-headline-wrap">
        <p class="reviews-headline">Trusted by 20,000+<span> Families?</span></p>
      </div>

      <div class="reviews-grid">
        {%- render 'review-cards' -%}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ GUARANTEE BOX ═══ {%- endcomment -%}
  {%- render 'guarantee-box' -%}

  {%- comment -%} ═══ OFFER CARD ═══ {%- endcomment -%}
  {%- render 'offer-card',
    cta_url: section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys'
  -%}

  {%- comment -%} ═══ FOOTER ═══ {%- endcomment -%}
  <footer class="pn-footer">
    <p>© 2026 Prime Naturals. All Rights Reserved.</p>
  </footer>

  <div class="pn-sticky-cta-bar" data-sticky-cta-widget>
    <div class="pn-sticky-cta-bar-inner">
      <span class="pn-sticky-cta-bar-text">Get 50% off the book today</span>
      <a href="{{ section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys' }}" class="pn-sticky-cta-bar-btn">GET 50% OFF →</a>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Parent Screen-Time Rescue",
  "settings": [
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "presets": [
    {
      "name": "Parent Screen-Time Rescue"
    }
  ]
}
{% endschema %}
