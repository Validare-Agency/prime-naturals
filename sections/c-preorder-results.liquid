{%- comment -%}
  "Loved by 18,000+ Families Worldwide" — survey stats for the Vol. 2
  pre-order PDP (templates/product.vol2-preorder.json). Editable port of the
  stats custom-liquid used on templates/product.vol2.json. Each stat card
  is a block.
{%- endcomment -%}

{%- assign heading_parts = section.settings.heading | split: '*' -%}

{%- style -%}
  #c-pre-results-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    #c-pre-results-{{ section.id }} {
      padding: {{ section.settings.desktop_padding_top }}px 16px {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="c-pre-results-{{ section.id }}" class="c-pre-results">
  <div class="c-pre-results__inner">
    <div class="c-pre-results__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="c-pre-results__eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="c-pre-results__heading">
          {%- for part in heading_parts -%}
            {%- assign odd = forloop.index0 | modulo: 2 -%}
            {%- if odd == 1 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}
          {%- endfor -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="c-pre-results__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="c-pre-results__cards">
      {%- for block in section.blocks -%}
        <div class="c-pre-results__card" {{ block.shopify_attributes }}>
          <p class="c-pre-results__num">
            {{- block.settings.number -}}
            {%- if block.settings.symbol != blank -%}<span>{{ block.settings.symbol }}</span>{%- endif -%}
          </p>
          {%- if block.settings.text != blank -%}<p class="c-pre-results__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.tag != blank -%}<span class="c-pre-results__tag">{{ block.settings.tag }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="c-pre-results__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

<style>
  .c-pre-results {
    color: #0d1b3e;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .c-pre-results__inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .c-pre-results__header { margin-bottom: 20px; }
  .c-pre-results__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 14px;
    padding: 5px 13px;
    border-radius: 100px;
    background: #dcfce7;
    color: #166534;
    font-weight: 700;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .c-pre-results__eyebrow span {
    flex: 0 0 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #166534;
  }
  .c-pre-results__heading {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-weight: 900;
    font-size: clamp(22px, 6vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: #0d1b3e;
  }
  .c-pre-results__heading em { font-style: italic; color: #c0392b; }
  .c-pre-results__sub {
    margin: 0;
    font-weight: 500;
    font-size: 13px;
    line-height: 1.65;
    color: #6b7280;
  }
  .c-pre-results__cards {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 16px;
  }
  .c-pre-results__card {
    padding: 24px 16px 20px;
    border: 1px solid rgba(13, 27, 62, 0.07);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(13, 27, 62, 0.05), 0 6px 20px rgba(13, 27, 62, 0.07);
    text-align: center;
  }
  .c-pre-results__num {
    margin: 0 0 9px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    font-weight: 900;
    font-size: clamp(44px, 12vw, 54px);
    line-height: 1;
    letter-spacing: -2px;
    color: #0d1b3e;
  }
  .c-pre-results__num span {
    margin-top: 8px;
    font-size: 50%;
    line-height: 1;
    letter-spacing: 0;
    color: #c0392b;
  }
  .c-pre-results__text {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.65;
    color: #6b7280;
  }
  .c-pre-results__tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 11px;
    border: 1px solid rgba(13, 27, 62, 0.07);
    border-radius: 100px;
    background: #f8f6f0;
    font-weight: 700;
    font-size: 11.5px;
    line-height: 1;
    color: #0d1b3e;
    white-space: nowrap;
  }
  .c-pre-results__footnote {
    margin: 0;
    font-size: 10.5px;
    line-height: 1.65;
    letter-spacing: 0.01em;
    color: #b0b7c3;
  }

  @media screen and (min-width: 750px) {
    .c-pre-results__header { margin-bottom: 24px; }
    .c-pre-results__sub { font-size: 14.5px; }
    .c-pre-results__cards { gap: 10px; }
    .c-pre-results__card { padding: 28px 20px 22px; border-radius: 14px; }
    .c-pre-results__num { margin-bottom: 10px; font-size: 62px; letter-spacing: -2.75px; }
    .c-pre-results__text { margin-bottom: 14px; font-size: 14.5px; }
    .c-pre-results__tag { padding: 5px 13px; font-size: 12px; }
    .c-pre-results__footnote { font-size: 11px; }
  }
</style>

{% schema %}
{
  "name": "Pre-order: Results",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The results speak for themselves"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in *asterisks* for the red italic highlight.",
      "default": "Loved by *18,000+* Families Worldwide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real parents. Real kids. Real results — tracked over 90 days."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Results from a 90-day post-purchase survey of 1,200+ customers, December 2024 – February 2025."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "94"
        },
        {
          "type": "text",
          "id": "symbol",
          "label": "Symbol",
          "default": "%"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "of parents say their child's school performance improved within 60 days"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "📈 School performance"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pre-order: Results",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "number": "97", "text": "of kids voluntarily picked up the book without being asked, after day 7", "tag": "📚 Voluntary reading" } },
        { "type": "stat", "settings": { "number": "91", "text": "of parents said their child started asking deeper, more insightful questions", "tag": "🧠 Curiosity & thinking" } }
      ]
    }
  ]
}
{% endschema %}
