{"name":"t:sections.header.name","type":"header","sections":{"header":{"type":"header","settings":{"sticky_header_type":"always","show_line_separator":true,"color_scheme":"background-1","logo_link":"https:\/\/primenaturals.store\/","logo_position":"middle-center","menu":"main-menu","menu_type_desktop":"dropdown","highlight_active_link":true,"highlighted_link_color_scheme":"accent-1","products_mega_menu_links":"","products_mega_menu_display_collection_products":true,"products_mega_menu_display_collection_images":true,"products_mega_menu_display_collection_images_on_mobile":true,"mobile_menu_title":"Menu","secondary_menu":"","menu_color_scheme":"background-1","mobile_logo_position":"center","display_search":false,"margin_bottom":0,"padding_top":12,"padding_bottom":12}},"custom_liquid_cGCAjY":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<div class=\"ann-bar\">\n  <div class=\"ann-bar__inner\">\n\n    <span class=\"ann-bar__bunny\">🔥<\/span>\n\n    <span class=\"ann-bar__text\">FLASH SALE ENDS IN<\/span>\n\n    <div class=\"ann-bar__timer\">\n      <span class=\"ann-bar__num\" id=\"ann-hours\">00<\/span>\n      <span class=\"ann-bar__sep\">:<\/span>\n      <span class=\"ann-bar__num\" id=\"ann-mins\">00<\/span>\n      <span class=\"ann-bar__sep\">:<\/span>\n      <span class=\"ann-bar__num\" id=\"ann-secs\">00<\/span>\n    <\/div>\n\n  <\/div>\n<\/div>\n\n<style>\n  .ann-bar *, .ann-bar *::before, .ann-bar *::after {\n    box-sizing: border-box; margin: 0; padding: 0;\n  }\n\n  .ann-bar {\n    background: #0d1b3e;\n    width: 100%;\n    padding: 10px 16px;\n  }\n\n  .ann-bar__inner {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    max-width: 960px;\n    margin: 0 auto;\n    flex-wrap: nowrap;\n  }\n\n  .ann-bar__bunny {\n    font-size: 18px;\n    line-height: 1;\n    flex-shrink: 0;\n  }\n\n  .ann-bar__text {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    color: rgba(255,255,255,0.9);\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  .ann-bar__timer {\n    display: flex;\n    align-items: center;\n    gap: 3px;\n    flex-shrink: 0;\n  }\n\n  .ann-bar__num {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    font-size: 15px;\n    font-weight: 900;\n    color: #ffffff;\n    background: rgba(255,255,255,0.1);\n    border-radius: 5px;\n    padding: 4px 7px;\n    min-width: 30px;\n    text-align: center;\n    line-height: 1;\n    letter-spacing: 0;\n  }\n\n  .ann-bar__sep {\n    font-size: 14px;\n    font-weight: 900;\n    color: rgba(255,255,255,0.3);\n    line-height: 1;\n  }\n\n  @media (max-width: 480px) {\n    .ann-bar { padding: 9px 12px; }\n    .ann-bar__bunny { font-size: 16px; }\n    .ann-bar__text { font-size: 12px; }\n    .ann-bar__num { font-size: 14px; min-width: 27px; padding: 3px 6px; }\n  }\n<\/style>\n\n<script>\n(function() {\n  var deadline = new Date();\n  deadline.setHours(deadline.getHours() + 4);\n  deadline.setMinutes(deadline.getMinutes() + 00);\n  deadline.setSeconds(deadline.getSeconds() + 00);\n\n  function pad(n) { return String(n).padStart(2, '0'); }\n\n  function tick() {\n    var remaining = deadline.getTime() - new Date().getTime();\n    if (remaining <= 0) {\n      document.getElementById('ann-hours').textContent = '00';\n      document.getElementById('ann-mins').textContent  = '00';\n      document.getElementById('ann-secs').textContent  = '00';\n      return;\n    }\n    document.getElementById('ann-hours').textContent = pad(Math.floor(remaining \/ 3600000));\n    document.getElementById('ann-mins').textContent  = pad(Math.floor((remaining % 3600000) \/ 60000));\n    document.getElementById('ann-secs').textContent  = pad(Math.floor((remaining % 60000) \/ 1000));\n  }\n\n  tick();\n  setInterval(tick, 1000);\n})();\n<\/script>","color_scheme":"background-1","padding_top":0,"padding_bottom":0}}},"order":["header","custom_liquid_cGCAjY"]}