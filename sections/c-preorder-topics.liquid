{%- comment -%}
  "What's inside Vol. 2" — topic grid for the Vol. 2 pre-order PDP
  (templates/product.vol2-preorder.json). Each topic is a block.
  Desktop: 3 columns. Mobile: 2 columns.
{%- endcomment -%}

{%- style -%}
  #c-pre-topics-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    #c-pre-topics-{{ section.id }} {
      padding: {{ section.settings.desktop_padding_top }}px 40px {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="c-pre-topics-{{ section.id }}" class="c-pre-topics">
  <div class="c-pre-topics__inner">
    {%- if section.settings.heading != blank or section.settings.highlight != blank -%}
      <h2 class="c-pre-topics__heading">
        {%- if section.settings.heading != blank -%}<span>{{ section.settings.heading }}</span>{%- endif -%}
        {%- if section.settings.highlight != blank -%}<mark>{{ section.settings.highlight }}</mark>{%- endif -%}
      </h2>
    {%- endif -%}

    <ul class="c-pre-topics__grid">
      {%- for block in section.blocks -%}
        <li class="c-pre-topics__card" {{ block.shopify_attributes }}>
          <span class="c-pre-topics__dot" style="background: {{ block.settings.dot_color }};" aria-hidden="true"></span>
          <span class="c-pre-topics__label">{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .c-pre-topics__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .c-pre-topics__heading {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-align: center;
    color: #fff;
  }
  .c-pre-topics__heading mark {
    padding: 2px 8px;
    border-radius: 6px;
    background: #f5a623;
    color: #0d1b3e;
    font-size: 28px;
    line-height: 1.2;
  }
  .c-pre-topics__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .c-pre-topics__card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 80px;
    padding: 16px;
    box-sizing: border-box;
    border: 1px solid rgba(217, 224, 230, 0.5);
    border-radius: 14px;
    background: #192648;
  }
  .c-pre-topics__dot {
    flex: 0 0 12px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .c-pre-topics__label {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.5;
    color: #fff;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .c-pre-topics__heading { gap: 10px; font-size: 40px; }
    .c-pre-topics__heading mark { font-size: 34px; }
    .c-pre-topics__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .c-pre-topics__card {
      min-height: 0;
      padding: 20px;
      border-color: rgba(217, 224, 230, 0.4);
    }
    .c-pre-topics__label { font-size: 17px; }
  }
</style>

{% schema %}
{
  "name": "Pre-order: Topics",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What’s inside"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlighted text",
      "default": "Vol. 2"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#0d1b3e"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Science experiments"
        },
        {
          "type": "color",
          "id": "dot_color",
          "label": "Dot color",
          "default": "#c0392b"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pre-order: Topics",
      "blocks": [
        { "type": "topic", "settings": { "text": "Science experiments", "dot_color": "#c0392b" } },
        { "type": "topic", "settings": { "text": "Animals & wildlife", "dot_color": "#f5a623" } },
        { "type": "topic", "settings": { "text": "Space & planets", "dot_color": "#166534" } },
        { "type": "topic", "settings": { "text": "Weather & nature", "dot_color": "#1f3a5f" } },
        { "type": "topic", "settings": { "text": "Explorers & adventure", "dot_color": "#c0392b" } },
        { "type": "topic", "settings": { "text": "Records & oddities", "dot_color": "#f5a623" } }
      ]
    }
  ]
}
{% endschema %}
