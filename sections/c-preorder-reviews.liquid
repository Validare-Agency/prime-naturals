{%- comment -%}
  "What parents say about Vol. 2" — review cards for the Vol. 2 pre-order
  PDP (templates/product.vol2-preorder.json). Each review is a block.
{%- endcomment -%}

{%- style -%}
  #c-pre-reviews-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    #c-pre-reviews-{{ section.id }} {
      padding: {{ section.settings.desktop_padding_top }}px 20px {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="c-pre-reviews-{{ section.id }}" class="c-pre-revlist">
  {%- if section.settings.anchor_id != blank -%}
    {%- comment -%} Jump target for the rating link under the product title (default #reviews) {%- endcomment -%}
    <span id="{{ section.settings.anchor_id | handleize }}" class="c-pre-revlist__anchor" aria-hidden="true"></span>
  {%- endif -%}
  <div class="c-pre-revlist__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="c-pre-revlist__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="c-pre-revlist__cards">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <article class="c-pre-revlist__card" {{ block.shopify_attributes }}>
          <p class="c-pre-revlist__stars" aria-label="{{ bs.rating }} out of 5 stars">
            {%- for i in (1..bs.rating) -%}★{%- endfor -%}
          </p>
          {%- if bs.text != blank -%}<p class="c-pre-revlist__text">{{ bs.text }}</p>{%- endif -%}
          <div class="c-pre-revlist__author">
            <span class="c-pre-revlist__avatar">
              {%- if bs.avatar != blank -%}
                {{ bs.avatar | image_url: width: 84 | image_tag: width: 42, height: 42, loading: 'lazy', alt: bs.name }}
              {%- elsif bs.avatar_url != blank -%}
                <img src="{{ bs.avatar_url }}" alt="{{ bs.name | escape }}" width="42" height="42" loading="lazy">
              {%- endif -%}
            </span>
            <span class="c-pre-revlist__who">
              <span class="c-pre-revlist__name">{{ bs.name }}</span>
              <span class="c-pre-revlist__meta">
                {{- bs.meta -}}
                {%- if bs.verified and section.settings.verified_label != blank -%}
                  {%- if bs.meta != blank %} · {% endif -%}
                  <strong>✔ {{ section.settings.verified_label }}</strong>
                {%- endif -%}
              </span>
            </span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .c-pre-revlist {
    color: #0d1b3e;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  /* Clears the sticky header when jumped to */
  .c-pre-revlist__anchor { display: block; scroll-margin-top: 90px; }
  .c-pre-revlist__inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .c-pre-revlist__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-align: center;
    color: #0d1b3e;
  }
  .c-pre-revlist__cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .c-pre-revlist__card {
    padding: 20px 13px 18px;
    border: 1px solid rgba(13, 27, 62, 0.07);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(13, 27, 62, 0.05), 0 6px 20px rgba(13, 27, 62, 0.06);
  }
  .c-pre-revlist__stars {
    margin: 0;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.13em;
    color: #f59e0b;
  }
  .c-pre-revlist__text {
    margin: 12px 0 0;
    font-style: italic;
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: #1a1a2e;
  }
  .c-pre-revlist__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(13, 27, 62, 0.07);
  }
  .c-pre-revlist__avatar {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    box-sizing: border-box;
    border: 2px solid rgba(13, 27, 62, 0.08);
    border-radius: 50%;
    overflow: hidden;
  }
  .c-pre-revlist__avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .c-pre-revlist__who { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .c-pre-revlist__name {
    font-weight: 800;
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.015em;
    color: #0d1b3e;
  }
  .c-pre-revlist__meta {
    font-weight: 500;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #9ca3af;
  }
  .c-pre-revlist__meta strong { font-weight: 700; color: #166534; }

  @media screen and (min-width: 750px) {
    .c-pre-revlist__inner { gap: 24px; }
    .c-pre-revlist__heading { font-size: 32px; text-align: left; }
    .c-pre-revlist__card { padding: 26px 26px 22px; border-radius: 16px; }
    .c-pre-revlist__stars { font-size: 16px; letter-spacing: 0.1em; }
    .c-pre-revlist__text { font-size: 15px; line-height: 1.75; letter-spacing: -0.015em; }
    .c-pre-revlist__avatar { flex-basis: 42px; width: 42px; height: 42px; }
    .c-pre-revlist__name { font-size: 14px; }
    .c-pre-revlist__meta { font-size: 12.5px; line-height: 1; }
  }
</style>

{% schema %}
{
  "name": "Pre-order: Review list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What parents say about Vol. 2"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Links to #this-id jump here. The rating under the product title links to #reviews.",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified label",
      "default": "Verified buyer"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fcfcfc"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "\"Write the review here.\""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Rachel M."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Detail",
          "default": "Mom of two · Texas"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "avatar_url",
          "label": "Avatar URL",
          "info": "Used when no avatar image is picked."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pre-order: Review list",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
