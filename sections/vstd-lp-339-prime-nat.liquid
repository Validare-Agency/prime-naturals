                function checkoutLoad(e) {
                  const tnc = document.querySelector('#TNC-Checkbox-cart-drawer');
                  if (tnc && tnc.dataset.checked != 'true') return;
                  const clickedBtn = e.currentTarget;
                  if (!clickedBtn) return;
                  clickedBtn.classList.add('vy-loading');
                  // clickedBtn.disabled = true;
                  const clickedBtnSpinner = clickedBtn.querySelector('.vy-loading-overlay__spinner');
                  if (clickedBtnSpinner) clickedBtnSpinner.classList.remove('vy-hidden');

                  setTimeout(() => {
                    if (document.location.pathname.includes('/checkout')) return;
                    clickedBtn.classList.remove('vy-loading');
                    clickedBtn.disabled = false;
                    if (clickedBtnSpinner) clickedBtnSpinner.classList.add('vy-hidden');
                  }, 8000);
                }
              
  
