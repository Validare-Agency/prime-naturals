{%- comment -%}
  V_PRIME_MIX_30 Var A shows its "Recommended books" row under the payment
  icons instead, so PDP27 stays fully hidden there. Remove with the MIX_30
  test cleanup.
{%- endcomment -%}
<style>
  body.c-primeMix30VarA .c-pdp27 { display: none !important; }
</style>
{%- if section.index > 3 -%}
  {%- comment -%}
    Inlined synchronously so the variant gating applies before first paint —
    the full stylesheet below loads async (media=print swap trick) and would
    otherwise let the badge row flash visible for non-eligible visitors.
  {%- endcomment -%}
  <style>
    /* V_PRIME_PDP_27 winner (Var A): paid search visitors in the optimized
       group only — holdout visitors never see it. */
    .c-pdp27__var-a { display: none; }
    html.c-paidSearchVisitor body.c-validareOptimized .c-pdp27__var-a { display: block; }
    /* V_PRIME_MIX_30 Var A shows its "Recommended books" row instead, so PDP27
       stays fully hidden — mirrors assets/c-prime-pdp-27.css. Remove with the
       MIX_30 test cleanup. */
    body.c-primeMix30VarA .c-pdp27 { display: none !important; }
  </style>
  <link rel="stylesheet" href="{{ 'c-prime-pdp-27.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'c-prime-pdp-27.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'c-prime-pdp-27.js' | asset_url }}" defer="defer"></script>

<div class="c-pdp27">
  <div class="c-pdp27__inner page-width">

    <!-- V_PRIME_PDP_27 winner (Var A): compact badge row near price -->
    <div class="c-pdp27__var-a" aria-hidden="true">
      <div class="c-pdp27__badge-panel">
        <div class="c-pdp27__badge-row">
          <div class="c-pdp27__badge-card">
            <p class="c-pdp27__badge-value">17.6 &times; 25 cm</p>
            <p class="c-pdp27__badge-label">Size</p>
          </div>
          <div class="c-pdp27__badge-card">
            <p class="c-pdp27__badge-value">1.8 cm thick</p>
            <p class="c-pdp27__badge-label">Thick</p>
          </div>
          <div class="c-pdp27__badge-card">
            <p class="c-pdp27__badge-value">680 g</p>
            <p class="c-pdp27__badge-label">Weight</p>
          </div>
          <div class="c-pdp27__badge-card">
            <p class="c-pdp27__badge-value">174</p>
            <p class="c-pdp27__badge-label">Q&amp;As</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "C PDP 27 - Physical Size",
  "settings": [],
  "presets": [
    {
      "name": "C PDP 27 - Physical Size"
    }
  ]
}
{% endschema %}
