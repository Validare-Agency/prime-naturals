        "custom_liquid": "<div class=\"stats-wrap\">\n\n  <h2 class=\"stats-heading\">Loved by <em>5,000+</em> Families Worldwide</h2>\n\n  <div class=\"stats-grid\">\n\n    <div class=\"stats-card\">\n      <div class=\"stats-accent\"></div>\n      <div class=\"stats-pct\">92<span class=\"stats-sym\">%</span></div>\n      <p class=\"stats-desc\">of parents said their child handled setbacks more calmly within 30 days</p>\n    </div>\n\n    <div class=\"stats-card\">\n      <div class=\"stats-accent\"></div>\n      <div class=\"stats-pct\">96<span class=\"stats-sym\">%</span></div>\n      <p class=\"stats-desc\">of kids read it voluntarily — many finishing it in a single sitting</p>\n    </div>\n\n    <div class=\"stats-card\">\n      <div class=\"stats-accent\"></div>\n      <div class=\"stats-pct\">89<span class=\"stats-sym\">%</span></div>\n      <p class=\"stats-desc\">of parents noticed their child became more resilient and solution-focused</p>\n    </div>\n\n  </div>\n\n  <p class=\"stats-footnote\">\n    Results from a 90-day post-purchase survey of 800+ customers, November 2024 – January 2025.\n  </p>\n\n</div>\n\n<style>\n  .stats-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    width: 100%;\n    max-width: 640px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    color: #0d1b3e;\n  }\n\n  /* ── HEADING ── */\n  .stats-heading {\n    font-size: clamp(21px, 4.5vw, 28px);\n    font-weight: 900;\n    line-height: 1.18;\n    letter-spacing: -0.5px;\n    color: #0d1b3e;\n    margin: 0 0 24px 0;\n  }\n  .stats-heading em {\n    font-style: italic;\n    color: #c0392b;\n    font-weight: 900;\n  }\n\n  /* ── GRID ── */\n  .stats-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    margin-bottom: 20px;\n  }\n\n  /* ── CARD ── */\n  .stats-card {\n    position: relative;\n    background: #ffffff;\n    border: 1px solid rgba(13,27,62,0.07);\n    border-radius: 16px;\n    padding: 36px 32px 32px;\n    text-align: center;\n    box-sizing: border-box;\n    overflow: hidden;\n    box-shadow:\n      0 1px 3px rgba(13,27,62,0.05),\n      0 6px 20px rgba(13,27,62,0.07);\n    transition: transform 0.22s ease, box-shadow 0.22s ease;\n  }\n  .stats-card:hover {\n    transform: translateY(-3px);\n    box-shadow:\n      0 2px 6px rgba(13,27,62,0.07),\n      0 12px 32px rgba(13,27,62,0.11);\n  }\n\n  /* Top accent bar */\n  .stats-accent {\n    position: absolute;\n    top: 0; left: 50%;\n    transform: translateX(-50%);\n    width: 48px; height: 3px;\n    background: #c0392b;\n    border-radius: 0 0 4px 4px;\n  }\n\n  /* ── BIG NUMBER ── */\n  .stats-pct {\n    font-size: clamp(58px, 12vw, 72px);\n    font-weight: 900;\n    color: #0d1b3e;\n    line-height: 1;\n    letter-spacing: -3px;\n    margin-bottom: 14px;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    gap: 2px;\n  }\n  .stats-sym {\n    font-size: 52%;\n    font-weight: 900;\n    color: #c0392b;\n    margin-top: 8px;\n    letter-spacing: 0;\n  }\n\n  /* ── DESCRIPTION ── */\n  .stats-desc {\n    font-size: clamp(13.5px, 2.2vw, 15px);\n    line-height: 1.65;\n    color: #6b7280;\n    margin: 0 auto;\n    max-width: 300px;\n  }\n\n  /* ── FOOTNOTE ── */\n  .stats-footnote {\n    font-size: 11.5px;\n    color: #b0b7c3;\n    text-align: center;\n    line-height: 1.65;\n    margin: 0;\n    letter-spacing: 0.01em;\n  }\n\n  /* ── MOBILE ── */\n  @media (max-width: 480px) {\n    .stats-card {\n      padding: 30px 20px 26px;\n      border-radius: 14px;\n    }\n    .stats-pct { letter-spacing: -2px; }\n    .stats-desc { max-width: 100%; }\n    .stats-footnote { font-size: 11px; }\n  }\n</style>",
