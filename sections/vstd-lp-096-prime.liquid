<script>(function(){
  function toggleGroup(uid){
    var hidden = document.querySelectorAll('[data-clone-hidden-by="' + uid + '"]');
    if (!hidden.length) return;
    var nowVisible = hidden[0].style.display === 'block';
    hidden.forEach(function(el){ el.style.display = nowVisible ? '' : 'block'; });
    var trig = document.querySelector('[data-clone-reveal="' + uid + '"]');
    if (trig) {
      trig.classList.toggle('active', !nowVisible);
      var p = trig.matches('p') ? trig : trig.querySelector('p');
      if (p) {
        var t = p.textContent;
        if (!nowVisible && /\bMore\b/i.test(t)) p.textContent = t.replace(/\bMore\b/i, 'Less');
        else if (nowVisible && /\bLess\b/i.test(t)) p.textContent = t.replace(/\bLess\b/i, 'More');
      }
    }
  }
  document.addEventListener('click', function(e){
    var trig = e.target.closest('[data-clone-reveal]');
    if (!trig) return;
    e.preventDefault();
    toggleGroup(trig.getAttribute('data-clone-reveal'));
  });
  document.querySelectorAll('[data-clone-reveal]').forEach(function(el){ el.style.cursor = 'pointer'; });
})();</script>

