<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Inter:ital,wght@0,400;0,700;0,800;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'sticky-cta.css' | asset_url }}">
<script src="{{ 'sticky-cta.js' | asset_url }}" defer></script>

<style>
.shopify-section-group-header-group,
.shopify-section-group-footer-group,
#header-group,
#footer-group,
.announcement-bar-section { display: none !important; }

.pn-sqkc *,
.pn-sqkc *::before,
.pn-sqkc *::after { box-sizing: border-box; margin: 0; padding: 0; }

.pn-sqkc {
  font-family: 'Inter', sans-serif;
  color: #1d2333;
  background: #fff;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  gap: 40px;
}

/* ── Layout helpers ── */
.pn-sqkc .wrap {
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
}
.pn-sqkc .wrap-wide {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── CTA Button ── */
.pn-sqkc .cta-btn {
  display: inline-block;
  background: #e14b3c;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  font-size: 20px;
  letter-spacing: 0.2px;
  text-decoration: none;
  padding: 19px 32px;
  border-radius: 10px;
  text-align: center;
  line-height: 1.4;
  transition: opacity 0.2s;
}
.pn-sqkc .cta-btn:hover { opacity: 0.9; }

/* ═══════════════════════════════════
   SECTION 1 — HERO
═══════════════════════════════════ */
.pn-sqkc .hero { padding: 56px 0 0; }
.pn-sqkc .hero-eyebrow {
  font-family: 'Inter', sans-serif;
  font-weight: 800;
  font-size: 15px;
  color: #2e8b4f;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 14px;
}
.pn-sqkc .hero-h1 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 46px;
  line-height: 1.18;
  color: #14213d;
  margin-bottom: 16px;
}
.pn-sqkc .hero-sub {
  font-size: 23px;
  line-height: 1.68;
  color: #5b6072;
  margin-bottom: 20px;
}
.pn-sqkc .hero-stars {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}
.pn-sqkc .stars-gold { color: #f5a623; font-size: 20px; letter-spacing: 1px; }
.pn-sqkc .stars-text { font-size: 19px; color: #5B6072; font-weight: 700; }
.pn-sqkc .stars-sub { font-size: 19px; color: #5b6072; }
.pn-sqkc .hero-cta-wrap { margin-bottom: 32px; }

/* ── Hero image ── */
.pn-sqkc .hero-img-wrap {
  position: relative;
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
}
.pn-sqkc .hero-img-main {
  width: 100%;
  display: block;
}
/* ═══════════════════════════════════
   SECTION 2 — BREAKDOWN
═══════════════════════════════════ */
.pn-sqkc .breakdown-intro {
  font-size: 17px;
  font-style: italic;
  color: #5b6072;
  text-align: center;
  margin-bottom: 8px;
}
.pn-sqkc .breakdown-h2 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 33px;
  color: #14213d;
  text-align: center;
  line-height: 1.3;
  margin-bottom: 32px;
}
.pn-sqkc .breakdown-item { margin-bottom: 42px; }
.pn-sqkc .breakdown-item:last-child { margin-bottom: 0; }
.pn-sqkc .breakdown-label {
  font-weight: 800;
  font-size: 15px;
  color: #e14b3c;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  margin-bottom: 4px;
}
.pn-sqkc .breakdown-h3 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 28px;
  color: #14213d;
  line-height: 1.21;
  margin-bottom: 12px;
}
.pn-sqkc .breakdown-p {
  font-size: 24px;
  line-height: 1.47;
  color: #1d2333;
  margin-bottom: 14px;
}
.pn-sqkc .breakdown-highlight {
  background: #eaf6ec;
  border-radius: 10px;
  padding: 14px 18px;
  font-weight: 700;
  font-size: 22px;
  line-height: 1.38;
  color: #1f5c33;
}

/* ═══════════════════════════════════
   SECTION 3 — SOCIAL PROOF
═══════════════════════════════════ */
.pn-sqkc .social-proof-wrap {
  position: relative;
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 716 / 400;
  margin-bottom: 8px;
}
.pn-sqkc .social-proof-wrap img.sp-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.pn-sqkc .social-proof-wrap img.sp-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.pn-sqkc .sp-badge-families {
  position: absolute;
  bottom: 8px;
  left: 8px;
  background: #fff;
  border: 1px solid #e0d0c0;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 13px;
  white-space: nowrap;
}
.pn-sqkc .sp-badge-families .badge-emoji { font-size: 20px; }
.pn-sqkc .sp-badge-families .badge-text-title {
  font-weight: 700;
  font-size: 15px;
  color: #1a1a1a;
  letter-spacing: -0.3px;
}
.pn-sqkc .sp-badge-bestseller {
  position: absolute;
  top: 8px;
  right: 8px;
  background: #166534;
  color: #fff;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: -0.3px;
  border-radius: 10px;
  padding: 10px 13px;
  white-space: nowrap;
}
.pn-sqkc .sp-cta-wrap {
  display: flex;
  justify-content: center;
  padding: 32px 0 0;
}

/* ═══════════════════════════════════
   SECTION 5 — REACTION + VIDEOS
═══════════════════════════════════ */
.pn-sqkc .section-divider {
  height: 1px;
  background: #e6e8ec;
  margin: 40px 0;
  display: block;
}
.pn-sqkc .testimonials-section .wrap > .section-divider:first-child {
  margin-top: 0;
}
.pn-sqkc .testimonials-h2 {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 700;
  font-size: 33px;
  color: #14213d;
  text-align: center;
  margin-bottom: 32px;
}
.pn-sqkc .reaction-img-wrap {
  background: #fff3e8;
  border-radius: 14px;
  overflow: hidden;
  width: 100%;
  max-width: 710px;
  margin: 0 auto 40px;
  aspect-ratio: 1512 / 2016;
}
.pn-sqkc .reaction-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pn-sqkc .reviews-headline-wrap {
  text-align: center;
  margin-bottom: 24px;
}
.pn-sqkc .reviews-headline {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 35px;
  color: #14213d;
  line-height: 1.4;
}
.pn-sqkc .reviews-headline span { color: #c0392b; }

/* ── Video stills row ── */
.pn-sqkc .video-stills-row {
  display: flex;
  gap: 14px;
  justify-content: center;
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.pn-sqkc .video-still {
  width: 167px;
  aspect-ratio: 167 / 297;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}
.pn-sqkc .video-still img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── Review grid ── */
.pn-sqkc .reviews-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  max-width: 760px;
  margin: 0 auto;
}
.pn-sqkc .review-card {
  background: #fff;
  border: 1px solid #e6e8ec;
  border-radius: 10px;
  padding: 23px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.pn-sqkc .review-stars { color: #f5a623; font-size: 18px; letter-spacing: 1px; }
.pn-sqkc .review-text {
  font-size: 19px;
  line-height: 32px;
  color: #1d2333;
  flex: 1;
}
.pn-sqkc .review-author {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 6px;
}
.pn-sqkc .review-avatar {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.pn-sqkc .review-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pn-sqkc .review-name { font-weight: 700; font-size: 17px; color: #1d2333; }
.pn-sqkc .review-role { font-size: 15px; color: #5b6072; display: inline-block; }
.pn-sqkc .review-verified { font-weight: 700; font-size: 15px; color: #2e8b4f; display: inline-block; }

/* ═══════════════════════════════════
   SECTION 6 — OFFER
═══════════════════════════════════ */
/* ── Footer ── */
.pn-sqkc .pn-footer {
  background: #e14b3c;
  padding: 20px;
  text-align: center;
}
.pn-sqkc .pn-footer p { font-size: 14px; color: #fff; line-height: 1.68; }

/* ═══════════════════════════════════
   MOBILE STYLES (≤749px)
═══════════════════════════════════ */
@media (max-width: 749px) {
  .pn-sqkc { gap: 24px; }
  .pn-sqkc .hero { padding: 28px 0 0; }
  .pn-sqkc .hero-h1 { font-size: 26px; }
  .pn-sqkc .hero-sub { font-size: 16px; }
  .pn-sqkc .hero-eyebrow { font-size: 11px; letter-spacing: 1.2px; }
  .pn-sqkc .stars-text, .pn-sqkc .stars-sub { font-size: 14px; }
  .pn-sqkc .cta-btn { width: 100%; font-size: 14px; padding: 15px 20px; }
  .pn-sqkc .hero-badge { font-size: 12px; padding: 4px 10px; }

  .pn-sqkc .breakdown-h2 { font-size: 22px; }
  .pn-sqkc .breakdown-p { font-size: 16px; }
  .pn-sqkc .breakdown-h3 { font-size: 20px; }
  .pn-sqkc .breakdown-highlight { font-size: 15px; }

  .pn-sqkc .sp-badge-families { bottom: 6%; left: 2%; font-size: 9px; gap: 5px; padding: 5px 7px; }
  .pn-sqkc .sp-badge-families .badge-emoji { font-size: 11px; }
  .pn-sqkc .sp-badge-families .badge-text-title { font-size: 9.5px; }
  .pn-sqkc .sp-badge-bestseller { font-size: 9.5px; padding: 5px 7px; border-radius: 6px; }

  .pn-sqkc .testimonials-h2 { font-size: 24px; }
  .pn-sqkc .reviews-headline { font-size: 22px; }
  .pn-sqkc .video-stills-row { gap: 8px; }
  .pn-sqkc .video-still { width: calc(50% - 8px); }
  .pn-sqkc .reviews-grid { grid-template-columns: 1fr; }
}
</style>

<div class="pn-sqkc">

  {%- comment -%} ═══ HERO ═══ {%- endcomment -%}
  <section class="hero">
    <div class="wrap">
      <p class="hero-eyebrow">👀 Wondering If This Is Legit? Fair Question.</p>
      <h1 class="hero-h1">Yes, It's a Real Book. Here's Exactly What You're Getting.</h1>
      <p class="hero-sub">If the ad felt too good to be true, here's the straight answer before you buy.</p>
      <div class="hero-stars">
        <span class="stars-gold">★★★★★</span>
        <span><span class="stars-text">4.9</span> <span class="stars-sub">· 2,847 verified reviews</span></span>
        <span class="stars-text">Bestseller for Ages 6 to 12</span>
      </div>
      <div class="hero-cta-wrap" data-sticky-cta-bar>
        <a href="{{ section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys' }}" class="cta-btn">GET 50% OFF ON THE BOOK →</a>
      </div>

      <div class="hero-img-wrap">
        <img class="hero-img-main" src="{{ 'spark-curiosity.png' | asset_url }}" alt="10,000 Whys Kids' Encyclopedia — premium hardcover with illustrated comic pages" width="712" height="398" loading="eager">
      </div>
    </div>
  </section>

  {%- comment -%} ═══ BREAKDOWN — WHAT YOU'RE GETTING ═══ {%- endcomment -%}
  <div class="wrap" style="margin-top: -20px;">
    <p class="breakdown-intro">No fine print. Here's the honest breakdown.</p>
    <h2 class="breakdown-h2">Exactly What You're Getting</h2>

    <div class="breakdown-item">
      <p class="breakdown-label">✔ What it actually is</p>
      <h3 class="breakdown-h3">A Real Hardcover, Not a Cheap Import</h3>
      <p class="breakdown-p">10,000 Why is a premium hardcover comic-style encyclopedia for ages 6 to 12. What you see in the video is exactly what ships, illustrated pages, "You know what?" fact boxes, the works.</p>
      <div class="breakdown-highlight">Premium hardcover. Built to survive a 7-year-old.</div>
    </div>

    <div class="breakdown-item">
      <p class="breakdown-label">✔ Why the price looks low</p>
      <h3 class="breakdown-h3">The 50% Off Is a Real Sale, Not a Gimmick</h3>
      <p class="breakdown-p">The list price is $79.80. The current flash price is $39.90. That's a genuine limited promotion, not a fake anchor, and it's backed by a full refund guarantee either way.</p>
      <div class="breakdown-highlight">$79.80 → $39.90, with a 30-day money-back guarantee.</div>
    </div>

    <div class="breakdown-item">
      <p class="breakdown-label">✔ If it's not right</p>
      <h3 class="breakdown-h3">30 Days to Change Your Mind, No Questions</h3>
      <p class="breakdown-p">If your grandkid doesn't take to it, you send it back and get every penny returned. The risk is entirely on us, not you.</p>
      <div class="breakdown-highlight">18,000+ families and a 4.9 rating across 2,847 reviews.</div>
    </div>
  </div>

  {%- comment -%} ═══ SOCIAL PROOF IMAGE ═══ {%- endcomment -%}
  <div class="wrap">
    <div class="social-proof-wrap">
      <img class="sp-bg" src="{{ 'social-proof.png' | asset_url }}" alt="Family enjoying 10,000 Why in a cozy living room" width="716" height="400" loading="lazy">
    </div>
    <div class="sp-cta-wrap" data-sticky-cta-bar>
      <a href="{{ section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys' }}" class="cta-btn">GET 50% OFF ON THE BOOK →</a>
    </div>
  </div>

  {%- comment -%} ═══ TOPICS GRID ═══ {%- endcomment -%}
  {%- render 'topics-grid' -%}

  {%- comment -%} ═══ REACTION + VIDEO TESTIMONIALS ═══ {%- endcomment -%}
  <section class="testimonials-section">
    <div class="wrap">

      <div class="section-divider"></div>
      <h2 class="testimonials-h2">See Their Reaction</h2>

      <div class="reaction-img-wrap">
        <img src="{{ 'pstr-reaction.png' | asset_url }}" alt="Child's delighted reaction reading the book" width="480" height="640" loading="lazy">
      </div>

      <div class="section-divider"></div>

      <div class="reviews-headline-wrap">
        <p class="reviews-headline">Trusted by 20,000+<span> Families?</span></p>
      </div>

      <div class="video-stills-row">
        <div class="video-still">
          <img src="{{ 'sqkc-video-1.png' | asset_url }}" alt="Parent sharing their experience with 10,000 Why" width="167" height="297" loading="lazy">
        </div>
        <div class="video-still">
          <img src="{{ 'sqkc-video-2.png' | asset_url }}" alt="Child excited about the book" width="167" height="297" loading="lazy">
        </div>
        <div class="video-still">
          <img src="{{ 'sqkc-video-3.png' | asset_url }}" alt="Dad reviewing the encyclopedia with his kids" width="167" height="297" loading="lazy">
        </div>
        <div class="video-still">
          <img src="{{ 'sqkc-video-5.png' | asset_url }}" alt="Grandmother sharing her experience with 10,000 Why" width="167" height="297" loading="lazy">
        </div>
      </div>

      <div class="reviews-grid">
        {%- render 'review-cards' -%}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ GUARANTEE BOX ═══ {%- endcomment -%}
  {%- render 'guarantee-box' -%}

  {%- comment -%} ═══ OFFER CARD ═══ {%- endcomment -%}
  {%- render 'offer-card',
    cta_url: section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys'
  -%}

  {%- comment -%} ═══ FOOTER ═══ {%- endcomment -%}
  <footer class="pn-footer">
    <p>© 2026 Prime Naturals. All Rights Reserved.</p>
  </footer>

  <div class="pn-sticky-cta-bar" data-sticky-cta-widget>
    <div class="pn-sticky-cta-bar-inner">
      <span class="pn-sticky-cta-bar-text">Get 50% off the book today</span>
      <a href="{{ section.settings.cta_url | default: 'https://primenaturals.store/products/kids-encyclopedia-100-000-whys' }}" class="pn-sticky-cta-bar-btn">GET 50% OFF →</a>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Science Questions",
  "settings": [
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "presets": [
    {
      "name": "Science Questions"
    }
  ]
}
{% endschema %}
