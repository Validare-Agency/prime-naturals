  <script>
 const TOTAL_NEEDED = 10;

  function injectCharmBar() {
    if (document.getElementById('charm-sticky-bar')) return;

    const bar = document.createElement('div');
    bar.id = 'charm-sticky-bar';
    bar.style = `
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #1e1e1e;
      padding: 14px 20px;
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      font-family: 'Inter', sans-serif;
      z-index: 100;
    `;

    const msg = document.createElement('div');
    msg.id = 'charm-progress-message';
    msg.style = `
      font-weight: 600;
      font-size: 15px;
      color: #ffffff;
      margin-bottom: 10px;
    `;

    bar.appendChild(msg);
    // Checkout button removed
    document.body.appendChild(bar);
  }

  async function updateCharmBar() {
    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();

      let charmCount = 0;
      cart.items.forEach(item => {
        const type = item.product_type?.toLowerCase() || '';
        switch (type) {
          case 'mystery10':
            charmCount += item.quantity * 10;
            break;
          case 'mystery5':
            charmCount += item.quantity * 5;
            break;
          case 'charm':
            charmCount += item.quantity;
            break;
        }
      });

      const bar = document.getElementById('charm-sticky-bar');
      const msg = document.getElementById('charm-progress-message');

      if (charmCount >= TOTAL_NEEDED) {
        msg.innerText = 'Free gift unlocked!';
        bar.style.display = 'flex';

        if (!window._confettiTriggered) {
          window._confettiTriggered = true;
          confetti({ particleCount: 100, spread: 80, origin: { y: 0.7 } });
        }
      } else {
        bar.style.display = 'none';
        window._confettiTriggered = false;
      }
    } catch (err) {
      console.error('Charm bar error:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    injectCharmBar();
    setInterval(updateCharmBar, 2000);
  });


