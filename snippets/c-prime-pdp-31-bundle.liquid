{%- comment -%}
  V_PRIME_PDP_31 | Gift-Bundle Combo Replacing Tier 3
  Renders only on the encyclopedia PDP (kidss-encyclopedia-10-000-whys).
  Three variants (A/B/C) are all rendered; CSS shows the right one via body class.
  Body classes applied by assets/c-intelligems-tests.js:
    c-primePdp31VarA / c-primePdp31VarB / c-primePdp31VarC
  Styled by assets/c-prime-pdp-31.css, wired by assets/c-prime-pdp-31.js.
  Accepts: product, section
{%- endcomment -%}

{%- if product.handle == 'kidss-encyclopedia-10-000-whys' -%}

{%- liquid
  # Base encyclopedia price — same .90-ending formula as c-prime-pdp-17-bundle.liquid
  assign c_pdp31_enc_variant = product.selected_or_first_available_variant
  assign c_pdp31_enc_price = c_pdp31_enc_variant.price | divided_by: 100.0 | ceil | times: 100 | minus: 10

  # Murphy's Law For Kids
  assign c_pdp31_murphys_product = all_products['murphys-law-for-kids']
  assign c_pdp31_murphys_variant = c_pdp31_murphys_product.selected_or_first_available_variant
  assign c_pdp31_murphys_price = c_pdp31_murphys_variant.price | divided_by: 100.0 | ceil | times: 100 | minus: 10

  # Leadership Enlightenment For Kids (handle is murphys-law-for-kids-copy on this store)
  assign c_pdp31_leadership_product = all_products['murphys-law-for-kids-copy']
  assign c_pdp31_leadership_variant = c_pdp31_leadership_product.selected_or_first_available_variant
  assign c_pdp31_leadership_price = c_pdp31_leadership_variant.price | divided_by: 100.0 | ceil | times: 100 | minus: 10

  # Tier 1: 1 encyclopedia
  assign c_pdp31_t1_price = c_pdp31_enc_price
  assign c_pdp31_t1_compare = c_pdp31_enc_price | times: 2

  # Var A: Encyclopedia + Murphy's paid, Leadership free
  assign c_pdp31_vara_price = c_pdp31_enc_price | plus: c_pdp31_murphys_price
  assign c_pdp31_vara_full  = c_pdp31_enc_price | plus: c_pdp31_murphys_price | plus: c_pdp31_leadership_price
  assign c_pdp31_vara_save  = c_pdp31_leadership_price

  # Var B: Encyclopedia + Leadership paid, Murphy's free
  assign c_pdp31_varb_price = c_pdp31_enc_price | plus: c_pdp31_leadership_price
  assign c_pdp31_varb_full  = c_pdp31_enc_price | plus: c_pdp31_leadership_price | plus: c_pdp31_murphys_price
  assign c_pdp31_varb_save  = c_pdp31_murphys_price

  # Var C: 2× Encyclopedia, Murphy's free
  assign c_pdp31_varc_price = c_pdp31_enc_price | times: 2
  assign c_pdp31_varc_full  = c_pdp31_enc_price | times: 2 | plus: c_pdp31_murphys_price
  assign c_pdp31_varc_save  = c_pdp31_murphys_price
-%}

<div class="c-pdp31-wrapper">

  <p class="c-pdp31-eyebrow">&#9889; FLASH SALE &mdash; PRICES INCREASE IN 4 HOURS</p>

  {%- comment -%} Tier 1 — compact radio row, single book {%- endcomment -%}
  <label class="c-pdp31-tier1" for="c-pdp31-t1-{{ section.id }}">
