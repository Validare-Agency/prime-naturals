      type="radio"
      id="c-pdp31-t1-{{ section.id }}"
      name="c-pdp31-tier-{{ section.id }}"
      class="c-pdp31-tier1__radio"
      data-pdp31-tier="t1"
      data-variant-id="{{ c_pdp31_enc_variant.id }}"
      data-quantity="1"
      data-pdp31-price="{{ c_pdp31_t1_price | money }}"
      checked
