    <span class="c-pdp31-tier1__indicator" aria-hidden="true"></span>
    <span class="c-pdp31-tier1__body">
      <span class="c-pdp31-tier1__title">1 Book</span>
      <span class="c-pdp31-tier1__sub">For 1 child</span>
    </span>
    <span class="c-pdp31-tier1__prices">
      <span class="c-pdp31-tier1__price">{{ c_pdp31_t1_price | money }}</span>
      <span class="c-pdp31-tier1__compare">{{ c_pdp31_t1_compare | money }}</span>
    </span>
  </label>

