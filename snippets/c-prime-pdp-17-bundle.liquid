            <img class="c-pdp17-row__thumb" src="{{ c_pdp17_g_encyclopedia.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="30" height="41">
          </span>
        {%- endif -%}
        {%- if c_pdp17_g_murphys.featured_image -%}
          <span class="c-pdp17-row__thumb-wrap">
            <img class="c-pdp17-row__thumb" src="{{ c_pdp17_g_murphys.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="30" height="41">
          </span>
        {%- endif -%}
        {%- if c_pdp17_g_leadership.featured_image -%}
          <span class="c-pdp17-row__thumb-wrap">
            <img class="c-pdp17-row__thumb" src="{{ c_pdp17_g_leadership.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="30" height="41">
          </span>
        {%- endif -%}
      </span>
      <span class="c-pdp17-row__body">
        <span class="c-pdp17-row__title">The Complete Set</span>
        <span class="c-pdp17-row__subtitle">All 3 books &mdash; the full library</span>
        {%- if c_pdp17_g_t2_ships_free -%}
          <span class="c-pdp17-row__perk c-pdp17-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
        <span class="c-pdp17-row__gifts-inline">
          {%- if c_pdp17_gift_sticker_variant -%}
            <span class="c-pdp17-row__gift">
              {%- if c_pdp17_gift_sticker.featured_image -%}
                <img src="{{ c_pdp17_gift_sticker.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="40" height="40">
              {%- endif -%}
              <span class="c-pdp17-row__gift-info">
                <span class="c-pdp17-row__gift-name">Stickers</span>
                <span class="c-pdp17-row__gift-price">
                  <strong>FREE</strong>
                  {%- if c_pdp17_gift_sticker_variant.compare_at_price > 0 %}
                    <s>{{ c_pdp17_gift_sticker_variant.compare_at_price | money }}</s>
                  {%- endif %}
                </span>
              </span>
            </span>
          {%- endif -%}
          {%- if c_pdp17_gift_mystery_variant -%}
            <span class="c-pdp17-row__gift">
              {%- if c_pdp17_gift_mystery.featured_image -%}
                <img src="{{ c_pdp17_gift_mystery.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="40" height="40">
              {%- endif -%}
              <span class="c-pdp17-row__gift-info">
                <span class="c-pdp17-row__gift-name">Mystery Gift</span>
                <span class="c-pdp17-row__gift-price">
                  <strong>FREE</strong>
                  {%- if c_pdp17_gift_mystery_variant.compare_at_price > 0 %}
                    <s>{{ c_pdp17_gift_mystery_variant.compare_at_price | money }}</s>
                  {%- endif %}
                </span>
              </span>
            </span>
          {%- endif -%}
          {%- if c_pdp17_gift_giftcard_variant -%}
            <span class="c-pdp17-row__gift">
              {%- if c_pdp17_gift_giftcard.featured_image -%}
                <img src="{{ c_pdp17_gift_giftcard.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="40" height="40">
              {%- endif -%}
              <span class="c-pdp17-row__gift-info">
                <span class="c-pdp17-row__gift-name">Gift Card</span>
                <span class="c-pdp17-row__gift-price">
                  <strong>FREE</strong>
                  <s>{{ c_pdp17_gift_giftcard_display_value | money }}</s>
                </span>
              </span>
            </span>
          {%- endif -%}
        </span>
      </span>
      <span class="c-pdp17-row__prices">
        <span class="c-pdp17-row__price">{{ c_pdp17_g_t2_price | money }}</span>
        <span class="c-pdp17-row__compare">{{ c_pdp17_g_t2_compare | money }}</span>
        <span class="c-pdp17-row__save">Save {{ c_pdp17_g_t2_save | money }}</span>
      </span>
    </label>
  </div>

  <button type="button" class="c-pdp17-atc button button--full-width" data-pdp17-atc>
    <span data-pdp17-atc-price>{{ c_pdp17_g_t2_price | money }}</span>&nbsp;ADD TO CART
  </button>
</div>

<div class="c-pdp17-variant c-pdp17-variant--h" data-pdp17-builder>
  <p class="c-pdp17-builder__heading">Build your bundle:</p>

  <div class="c-pdp17-builder__slider">
    <div class="c-pdp17-builder__track">
      <div class="c-pdp17-builder__track-fill" data-pdp17-track-fill></div>
      {%- for n in (1..4) -%}
        <span class="c-pdp17-builder__node" data-pdp17-node="{{ n }}"></span>
      {%- endfor -%}
      <span class="c-pdp17-builder__best-deal">Best Deal</span>

      <span class="c-pdp17-builder__title" data-pdp17-title="1">1 Book</span>
      <span class="c-pdp17-builder__title" data-pdp17-title="2">2 Books</span>
      <span class="c-pdp17-builder__title" data-pdp17-title="3">3 Books</span>
      <span class="c-pdp17-builder__title" data-pdp17-title="4">4 Books</span>

      <span class="c-pdp17-builder__discount" data-pdp17-discount="2">15% Discount</span>
      <span class="c-pdp17-builder__discount" data-pdp17-discount="3">25% Discount</span>
      <span class="c-pdp17-builder__discount" data-pdp17-discount="4">35% Discount</span>
    </div>
  </div>

  {%- capture c_pdp17_h_row_encyclopedia -%}
    <div
      class="c-pdp17-builder__row"
      data-pdp17-builder-row
      data-variant-id="{{ c_pdp17_h_encyclopedia_variant_id }}"
      data-price-cents="{{ c_pdp17_h_encyclopedia_price }}"
    >
      {%- if c_pdp17_g_encyclopedia.featured_image -%}
        <img class="c-pdp17-builder__image" src="{{ c_pdp17_g_encyclopedia.featured_image | image_url: width: 240 }}" alt="" loading="lazy" width="80" height="80">
      {%- endif -%}
      <span class="c-pdp17-builder__info">
        <span class="c-pdp17-builder__name">Kid's Encyclopedia "10,000 Whys"</span>
        <span class="c-pdp17-builder__prices">
          <span class="c-pdp17-builder__price">{{ c_pdp17_h_encyclopedia_price | money }}</span>
          <span class="c-pdp17-builder__compare">{{ c_pdp17_h_encyclopedia_price | times: 2 | money }}</span>
        </span>
      </span>
      <div class="c-pdp17-builder__control">
        <button type="button" class="c-pdp17-builder__add" data-pdp17-add>Add +</button>
        <div class="c-pdp17-builder__stepper" data-pdp17-stepper hidden>
          <button type="button" class="c-pdp17-builder__step" data-pdp17-decrement>&minus;</button>
          <span class="c-pdp17-builder__qty" data-pdp17-qty>0</span>
          <button type="button" class="c-pdp17-builder__step" data-pdp17-increment>+</button>
        </div>
      </div>
    </div>
  {%- endcapture -%}

  {%- capture c_pdp17_h_row_murphys -%}
    <div
      class="c-pdp17-builder__row"
      data-pdp17-builder-row
      data-variant-id="{{ c_pdp17_h_murphys_variant_id }}"
      data-price-cents="{{ c_pdp17_h_murphys_price }}"
    >
      {%- if c_pdp17_g_murphys.featured_image -%}
        <img class="c-pdp17-builder__image" src="{{ c_pdp17_g_murphys.featured_image | image_url: width: 240 }}" alt="" loading="lazy" width="80" height="80">
      {%- endif -%}
      <span class="c-pdp17-builder__info">
        <span class="c-pdp17-builder__name">Murphy's Law Life Principles</span>
        <span class="c-pdp17-builder__prices">
          <span class="c-pdp17-builder__price">{{ c_pdp17_h_murphys_price | money }}</span>
          <span class="c-pdp17-builder__compare">{{ c_pdp17_h_murphys_price | times: 2 | money }}</span>
        </span>
      </span>
      <div class="c-pdp17-builder__control">
        <button type="button" class="c-pdp17-builder__add" data-pdp17-add>Add +</button>
        <div class="c-pdp17-builder__stepper" data-pdp17-stepper hidden>
          <button type="button" class="c-pdp17-builder__step" data-pdp17-decrement>&minus;</button>
          <span class="c-pdp17-builder__qty" data-pdp17-qty>0</span>
          <button type="button" class="c-pdp17-builder__step" data-pdp17-increment>+</button>
        </div>
      </div>
    </div>
  {%- endcapture -%}

  {%- capture c_pdp17_h_row_leadership -%}
    <div
      class="c-pdp17-builder__row"
      data-pdp17-builder-row
      data-variant-id="{{ c_pdp17_h_leadership_variant_id }}"
      data-price-cents="{{ c_pdp17_h_leadership_price }}"
    >
      {%- if c_pdp17_g_leadership.featured_image -%}
        <img class="c-pdp17-builder__image" src="{{ c_pdp17_g_leadership.featured_image | image_url: width: 240 }}" alt="" loading="lazy" width="80" height="80">
      {%- endif -%}
      <span class="c-pdp17-builder__info">
        <span class="c-pdp17-builder__name">Leadership Enlightenment For Kids</span>
        <span class="c-pdp17-builder__prices">
          <span class="c-pdp17-builder__price">{{ c_pdp17_h_leadership_price | money }}</span>
          <span class="c-pdp17-builder__compare">{{ c_pdp17_h_leadership_price | times: 2 | money }}</span>
        </span>
      </span>
      <div class="c-pdp17-builder__control">
        <button type="button" class="c-pdp17-builder__add" data-pdp17-add>Add +</button>
        <div class="c-pdp17-builder__stepper" data-pdp17-stepper hidden>
          <button type="button" class="c-pdp17-builder__step" data-pdp17-decrement>&minus;</button>
          <span class="c-pdp17-builder__qty" data-pdp17-qty>0</span>
          <button type="button" class="c-pdp17-builder__step" data-pdp17-increment>+</button>
        </div>
      </div>
    </div>
  {%- endcapture -%}

  <div class="c-pdp17-builder__rows">
    {%- case product.handle -%}
      {%- when 'murphys-law-for-kids' -%}
        {{- c_pdp17_h_row_murphys -}}
        {{- c_pdp17_h_row_encyclopedia -}}
        {{- c_pdp17_h_row_leadership -}}
      {%- when 'murphys-law-for-kids-copy' -%}
        {{- c_pdp17_h_row_leadership -}}
        {{- c_pdp17_h_row_encyclopedia -}}
        {{- c_pdp17_h_row_murphys -}}
      {%- else -%}
        {{- c_pdp17_h_row_encyclopedia -}}
        {{- c_pdp17_h_row_murphys -}}
        {{- c_pdp17_h_row_leadership -}}
    {%- endcase -%}
  </div>

  <button type="button" class="c-pdp17-builder__cta" data-pdp17-builder-cta disabled>
    <span class="c-pdp17-builder__cta-compare" data-pdp17-builder-cta-compare hidden></span>
    <span data-pdp17-builder-cta-text>ADD TO CART</span>
  </button>
</div>
