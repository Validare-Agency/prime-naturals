{%- comment -%}
  V_PRIME_PDP_17 | Offer Restructure - PDP
  Renders one hidden block per variant. assets/c-prime-pdp-17.css shows only the
  block matching the active c-primePdp17Var* class on <body>; assets/c-prime-pdp-17.js
  wires row selection + Add to Cart. Control renders nothing here (the native
  Kaching Bundles app block above is left untouched).

  Accepts: product
{%- endcomment -%}

{%- liquid
  assign c_pdp17_variant = product.selected_or_first_available_variant
  assign c_pdp17_base_cents = c_pdp17_variant.price
  # Shopify's per-market currency conversion doesn't land on a clean .90
  # ending the way the confirmed USD price points do (e.g. CAD showed
  # $57.00 on our rows vs the $56.90 Shopify itself actually charges at
  # cart) — round every displayed price up to the next whole unit then
  # back off 10 cents, so it always ends in .90 like the rest of the site.
  # No-op for the USD prices (3990/6990/... already end in 90).
  assign c_pdp17_base_cents = c_pdp17_base_cents | divided_by: 100.0 | ceil | times: 100 | minus: 10

  # Tier 1 always adds the live product's own variant — no bundling needed for
  # a single book. Tiers 2/3 default to the same, then get overridden below for
  # whichever product's own Kaching bundle doesn't already match our target
  # prices — those route to a duplicate product carrying a corrected bundle.
  assign c_pdp17_t1_variant_id = c_pdp17_variant.id
  assign c_pdp17_t2_variant_id = c_pdp17_variant.id
  assign c_pdp17_t3_variant_id = c_pdp17_variant.id

  case product.handle
    when 'kidss-encyclopedia-10-000-whys'
      assign c_pdp17_bundle_product = all_products['kidss-encyclopedia-10-000-whys-var-a']
      assign c_pdp17_t2_variant_id = c_pdp17_bundle_product.selected_or_first_available_variant.id
      assign c_pdp17_t3_variant_id = c_pdp17_bundle_product.selected_or_first_available_variant.id
    when 'murphys-law-for-kids'
      assign c_pdp17_bundle_product = all_products['murphys-law-for-kids-var-a']
      assign c_pdp17_t2_variant_id = c_pdp17_bundle_product.selected_or_first_available_variant.id
      assign c_pdp17_t3_variant_id = c_pdp17_bundle_product.selected_or_first_available_variant.id
    when 'murphys-law-for-kids-copy'
      # Leadership's real live handle — legacy naming, unrelated to Murphy's Law.
      assign c_pdp17_bundle_product = all_products['leadership-enlightenment-for-kids-var-a']
      assign c_pdp17_t2_variant_id = c_pdp17_bundle_product.selected_or_first_available_variant.id
      assign c_pdp17_t3_variant_id = c_pdp17_bundle_product.selected_or_first_available_variant.id
  endcase

  # This store sells to 5 markets (US/AU/CA/NZ/UK) with Shopify auto-converting
  # variant.price to whatever currency the shopper is in — so c_pdp17_base_cents
  # is ALREADY a correctly-converted local amount, never literally "3990".
  # Every tier price below is therefore derived as a RATIO off that local base
  # price (matching the confirmed USD price points' own implied percentage),
  # not a hardcoded USD cents number — otherwise every non-USD market would
  # get the wrong tier's price entirely (a currency-agnostic handle check is
  # needed to know WHICH book this is, since the localized price can't be
  # compared against a fixed number to tell them apart).
  assign c_pdp17_is_encyclopedia = false
  if product.handle == 'kidss-encyclopedia-10-000-whys'
    assign c_pdp17_is_encyclopedia = true
  endif

  # Tier 1: 1 book, base price, no discount. Compare price is the site's
  # existing "50% off" anchor (base x2), same as shown everywhere else on the PDP.
  assign c_pdp17_a_t1_price = c_pdp17_base_cents
  assign c_pdp17_a_t1_compare = c_pdp17_base_cents | times: 2

  # Ratios below are locked to the confirmed USD price points — $39.90 book:
  # 2=$69.90 (÷3990), 3=$79.90 (÷3990); $29.90 books: 2=$49.90 (÷2990),
  # 3=$59.90 (÷2990) — applied to the local base price, then rounded to the
  # nearest cent.
  if c_pdp17_is_encyclopedia
    assign c_pdp17_a_t2_price = c_pdp17_base_cents | times: 6990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_a_t3_price = c_pdp17_base_cents | times: 7990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  else
    assign c_pdp17_a_t2_price = c_pdp17_base_cents | times: 4990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_a_t3_price = c_pdp17_base_cents | times: 5990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  endif

  # Compare price is N x the current per-book price (savings are layered on top
  # of the already-discounted single-book price, not the original MSRP).
  assign c_pdp17_a_t2_compare = c_pdp17_base_cents | times: 2
  assign c_pdp17_a_t2_save = c_pdp17_a_t2_compare | minus: c_pdp17_a_t2_price

  assign c_pdp17_a_t3_compare = c_pdp17_base_cents | times: 3
  assign c_pdp17_a_t3_save = c_pdp17_a_t3_compare | minus: c_pdp17_a_t3_price

  # Var B reuses Var A's exact tiers/pricing above, adding a free-shipping badge
  # on qualifying tiers and a free Stickers gift on the 3-book tier.
  # Free shipping threshold: $55 USD-equivalent, same vetted per-currency map
  # already shipped in assets/c-prime-cart-15.js (V_PRIME_CART_15).
  assign c_pdp17_ship_threshold_cents = 5500
  case cart.currency.iso_code
    when 'AUD' or 'CAD'
      assign c_pdp17_ship_threshold_cents = 8000
    when 'GBP'
      assign c_pdp17_ship_threshold_cents = 4500
    when 'NZD'
      assign c_pdp17_ship_threshold_cents = 9500
  endcase

  assign c_pdp17_t2_ships_free = false
  if c_pdp17_a_t2_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_t2_ships_free = true
  endif

  assign c_pdp17_t3_ships_free = false
  if c_pdp17_a_t3_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_t3_ships_free = true
  endif

  assign c_pdp17_gift_sticker = all_products['stickers']
  assign c_pdp17_gift_sticker_variant = c_pdp17_gift_sticker.selected_or_first_available_variant

  # Var C: BOGO framing. Tier 1 is the same as A/B. Tiers 2/3 are fixed BOGO
  # price points (not derived from A/B's percentages) — confirmed: $39.90 book:
  # 3 books for $79.90 / 5 books for $99.90; $29.90 books: 3 books for $49.90 /
  # 5 books for $59.90 (identical to A/B's tiers for the $29.90 books). Same
  # ratio-off-local-base-price approach as Var A/B — see the note above.
  if c_pdp17_is_encyclopedia
    assign c_pdp17_c_t2_price = c_pdp17_base_cents | times: 7990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_c_t3_price = c_pdp17_base_cents | times: 9990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  else
    assign c_pdp17_c_t2_price = c_pdp17_base_cents | times: 4990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_c_t3_price = c_pdp17_base_cents | times: 5990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  endif

  # Compare price is the summed per-book price for the FULL quantity received
  # (3 or 5 books), not just the paid quantity — "the compare price is the
  # summed comparison price, so it reads higher."
  assign c_pdp17_c_t2_compare = c_pdp17_base_cents | times: 3
  assign c_pdp17_c_t2_save = c_pdp17_c_t2_compare | minus: c_pdp17_c_t2_price

  assign c_pdp17_c_t3_compare = c_pdp17_base_cents | times: 5
  assign c_pdp17_c_t3_save = c_pdp17_c_t3_compare | minus: c_pdp17_c_t3_price

  # Var C's BOGO tiers only need their own duplicate where the paid amount
  # differs from Var A/B's — confirmed identical for the $29.90 books, so only
  # Every book needs its OWN "-var-c" duplicate, even where the final price
  # matches Var A/B's — Var A/B's duplicate for the $29.90 books is a native
  # bundle discount configured for 2/3 UNITS, but Var C's rows add that same
  # variant at 3/5 units, which that duplicate's discount was never set up
  # for (that mismatch is what caused 5 books to charge $99.90 instead of
  # $59.90 — reusing it only happened to work by coincidence for the price
  # text, never for the actual native discount tiers).
  # FALLS BACK to the Var A/B duplicate (the old, mismatched behavior) if a
  # book's own "-var-c" duplicate doesn't exist yet in admin — remove this
  # fallback once murphys-law-for-kids-var-c and
  # leadership-enlightenment-for-kids-var-c are created, so a typo'd handle
  # can't silently keep serving the wrong price forever.
  assign c_pdp17_c_t2_variant_id = c_pdp17_t2_variant_id
  assign c_pdp17_c_t3_variant_id = c_pdp17_t3_variant_id
  assign c_pdp17_bundle_product_c = blank
  case product.handle
    when 'kidss-encyclopedia-10-000-whys'
      assign c_pdp17_bundle_product_c = all_products['kidss-encyclopedia-10-000-whys-var-c']
    when 'murphys-law-for-kids'
      assign c_pdp17_bundle_product_c = all_products['murphys-law-for-kids-var-c']
    when 'murphys-law-for-kids-copy'
      assign c_pdp17_bundle_product_c = all_products['leadership-enlightenment-for-kids-var-c']
  endcase
  if c_pdp17_bundle_product_c != blank
    assign c_pdp17_c_t2_variant_id = c_pdp17_bundle_product_c.selected_or_first_available_variant.id
    assign c_pdp17_c_t3_variant_id = c_pdp17_bundle_product_c.selected_or_first_available_variant.id
  endif

  # Gift-unlock ladder for Var C's "Free Gifts Unlocked" panel — tier position
  # (row 1/2/3), not literal book count in cart. Stickers is on every tier
  # (including tier 1), Mystery Gift unlocks from tier 2, Gift Card from tier 3.
  assign c_pdp17_gift_mystery = all_products['mystery-gift']
  assign c_pdp17_gift_mystery_variant = c_pdp17_gift_mystery.selected_or_first_available_variant
  assign c_pdp17_gift_giftcard = all_products['15-gift-card']
  assign c_pdp17_gift_giftcard_variant = c_pdp17_gift_giftcard.selected_or_first_available_variant
  # The Gift Card stays a real, redeemable Shopify Gift Card product priced at
  # the real $15 (made free via a targeted 100%-off automatic discount, not a
  # $0 product price) — so it won't have a compare_at_price set. Fall back to
  # its real price for the "FREE $15.00" display in that case.
  assign c_pdp17_gift_giftcard_display_value = c_pdp17_gift_giftcard_variant.compare_at_price
  if c_pdp17_gift_giftcard_display_value == blank or c_pdp17_gift_giftcard_display_value == 0
    assign c_pdp17_gift_giftcard_display_value = c_pdp17_gift_giftcard_variant.price
  endif

  # Each entry embeds "variantId:minQty" (the row's own book quantity that
  # unlocks it: tier 1 = 1, tier 2 = 3, tier 3 = 5) — same format Var F uses —
  # so decreasing cart quantity only drops gifts whose own threshold is no
  # longer met, and increasing it (even via the cart's own stepper) re-adds
  # whichever gift the new quantity now qualifies for. See
  # c-prime-pdp-17.js's addToCart/cleanupOrphanedGifts.
  assign c_pdp17_c_t1_gift_ids = c_pdp17_gift_sticker_variant.id | append: ':1'
  assign c_pdp17_c_t2_gift_ids = c_pdp17_c_t1_gift_ids | append: ',' | append: c_pdp17_gift_mystery_variant.id | append: ':3'
  assign c_pdp17_c_t3_gift_ids = c_pdp17_c_t2_gift_ids | append: ',' | append: c_pdp17_gift_giftcard_variant.id | append: ':5'

  # Var D: same BOGO framing as Var C, plus a shipping badge on both tiers,
  # minus the gifts panel. Encyclopedia's numbers are identical to Var C's
  # ($79.90/$99.90), so it reuses Var C's duplicate — no new one needed.
  # Murphy's Law/Leadership have NEW confirmed numbers ($59.90/$89.90) that
  # differ from every other variant so far, requiring their own new duplicates.
  if c_pdp17_is_encyclopedia
    assign c_pdp17_d_t2_price = c_pdp17_base_cents | times: 7990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_d_t3_price = c_pdp17_base_cents | times: 9990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  else
    assign c_pdp17_d_t2_price = c_pdp17_base_cents | times: 5990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_d_t3_price = c_pdp17_base_cents | times: 8990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  endif

  assign c_pdp17_d_t2_compare = c_pdp17_base_cents | times: 3
  assign c_pdp17_d_t2_save = c_pdp17_d_t2_compare | minus: c_pdp17_d_t2_price

  assign c_pdp17_d_t3_compare = c_pdp17_base_cents | times: 5
  assign c_pdp17_d_t3_save = c_pdp17_d_t3_compare | minus: c_pdp17_d_t3_price

  assign c_pdp17_d_t2_ships_free = false
  if c_pdp17_d_t2_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_d_t2_ships_free = true
  endif

  assign c_pdp17_d_t3_ships_free = false
  if c_pdp17_d_t3_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_d_t3_ships_free = true
  endif

  assign c_pdp17_d_t2_variant_id = c_pdp17_t2_variant_id
  assign c_pdp17_d_t3_variant_id = c_pdp17_t3_variant_id
  case product.handle
    when 'kidss-encyclopedia-10-000-whys'
      assign c_pdp17_bundle_product_d = all_products['kidss-encyclopedia-10-000-whys-var-c']
      assign c_pdp17_d_t2_variant_id = c_pdp17_bundle_product_d.selected_or_first_available_variant.id
      assign c_pdp17_d_t3_variant_id = c_pdp17_bundle_product_d.selected_or_first_available_variant.id
    when 'murphys-law-for-kids'
      assign c_pdp17_bundle_product_d = all_products['murphys-law-for-kids-var-d']
      assign c_pdp17_d_t2_variant_id = c_pdp17_bundle_product_d.selected_or_first_available_variant.id
      assign c_pdp17_d_t3_variant_id = c_pdp17_bundle_product_d.selected_or_first_available_variant.id
    when 'murphys-law-for-kids-copy'
      assign c_pdp17_bundle_product_d = all_products['leadership-enlightenment-for-kids-var-d']
      assign c_pdp17_d_t2_variant_id = c_pdp17_bundle_product_d.selected_or_first_available_variant.id
      assign c_pdp17_d_t3_variant_id = c_pdp17_bundle_product_d.selected_or_first_available_variant.id
  endcase

  # Var E: identical pricing/variant IDs/copy to Var D (reuses the c_pdp17_d_*
  # values above) — the only difference is a book-cover thumbnail strip per
  # row, one thumb per book in that tier's quantity, with the free copies
  # tagged. No new duplicate products needed.

  # Var F: 5 tiers (1/2/3/4/5 books). Originally assumed the product's OWN
  # already-live bundle discount would keep producing these exact confirmed
  # totals with no duplicate needed — confirmed WRONG for Murphy's
  # Law/Leadership: their live discount is steeper than Var F's confirmed
  # numbers (e.g. 4 books charged $77 instead of $89.90), so Var F's displayed
  # price and the actual checkout total didn't match. Routes to a dedicated
  # "-var-f" duplicate (own bundle discount at the confirmed totals) once one
  # exists for a given book, same fallback-if-missing pattern as Var C.
  assign c_pdp17_f_variant_id = c_pdp17_t1_variant_id
  assign c_pdp17_bundle_product_f = blank
  case product.handle
    when 'kidss-encyclopedia-10-000-whys'
      assign c_pdp17_bundle_product_f = all_products['kidss-encyclopedia-10-000-whys-var-f']
    when 'murphys-law-for-kids'
      assign c_pdp17_bundle_product_f = all_products['murphys-law-for-kids-var-f']
    when 'murphys-law-for-kids-copy'
      assign c_pdp17_bundle_product_f = all_products['leadership-enlightenment-for-kids-var-f']
  endcase
  if c_pdp17_bundle_product_f != blank
    assign c_pdp17_f_variant_id = c_pdp17_bundle_product_f.selected_or_first_available_variant.id
  endif

  assign c_pdp17_f_t1_price = c_pdp17_base_cents
  if c_pdp17_is_encyclopedia
    assign c_pdp17_f_t2_price = c_pdp17_base_cents | times: 6990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_f_t3_price = c_pdp17_base_cents | times: 7990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_f_t4_price = c_pdp17_base_cents | times: 8990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_f_t5_price = c_pdp17_base_cents | times: 9990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  else
    assign c_pdp17_f_t2_price = c_pdp17_base_cents | times: 5890.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_f_t3_price = c_pdp17_base_cents | times: 7990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_f_t4_price = c_pdp17_base_cents | times: 8990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp17_f_t5_price = c_pdp17_base_cents | times: 9990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  endif

  # Compare price keeps the same "2x the tier's own total" anchor used by
  # every other variant on this PDP (base x quantity x 2), not the live
  # bundle's own compare_at_price.
  assign c_pdp17_f_t1_compare = c_pdp17_base_cents | times: 2
  assign c_pdp17_f_t2_compare = c_pdp17_base_cents | times: 4
  assign c_pdp17_f_t3_compare = c_pdp17_base_cents | times: 6
  assign c_pdp17_f_t4_compare = c_pdp17_base_cents | times: 8
  assign c_pdp17_f_t5_compare = c_pdp17_base_cents | times: 10

  assign c_pdp17_f_t2_ships_free = false
  if c_pdp17_f_t2_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_f_t2_ships_free = true
  endif
  assign c_pdp17_f_t3_ships_free = false
  if c_pdp17_f_t3_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_f_t3_ships_free = true
  endif
  assign c_pdp17_f_t4_ships_free = false
  if c_pdp17_f_t4_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_f_t4_ships_free = true
  endif
  assign c_pdp17_f_t5_ships_free = false
  if c_pdp17_f_t5_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_f_t5_ships_free = true
  endif

  # Gifts stack cumulatively: tier 3 = Stickers, tier 4 = + Mystery Gift,
  # tier 5 = + Gift Card. Each entry embeds "variantId:minQty" (the exact
  # book quantity that unlocked it) instead of a bare id list, so that
  # decreasing quantity in the cart (e.g. 5 -> 4) only drops the gift(s)
  # whose own threshold is no longer met — Gift Card drops, Stickers/Mystery
  # Gift stay — rather than the old behavior of dropping every gift the
  # moment quantity fell below whatever tier was originally selected.
  # c-prime-pdp-17.js's addToCart/cleanupOrphanedGifts parse this format.
  assign c_pdp17_f_t3_gift_ids = c_pdp17_gift_sticker_variant.id | append: ':3'
  assign c_pdp17_f_t4_gift_ids = c_pdp17_f_t3_gift_ids | append: ',' | append: c_pdp17_gift_mystery_variant.id | append: ':4'
  assign c_pdp17_f_t5_gift_ids = c_pdp17_f_t4_gift_ids | append: ',' | append: c_pdp17_gift_giftcard_variant.id | append: ':5'

  # Var G: cross-sell framing, not a quantity tier — "Just this book" vs "The
  # Complete Set" (all 3 books). Tier 1 is dynamic per whichever of the 3 PDPs
  # this renders on (own price/compare/cover); Tier 2 (Complete Set) is fixed
  # and identical no matter which PDP it renders from — same price, compare,
  # thumbnails, and variant everywhere, since it's the same physical bundle.
  # Tier 2 defaults CHECKED here, unlike every other variant on this page.
  assign c_pdp17_g_t1_price = c_pdp17_base_cents
  assign c_pdp17_g_t1_compare = c_pdp17_base_cents | times: 2

  # Liquid strings can't backslash-escape quotes, so building a string with
  # BOTH a literal double-quote and an apostrophe (Murphy's Law's subtitle)
  # needs concatenation instead of one literal.
  assign c_pdp17_dquote = '"'

  case product.handle
    when 'kidss-encyclopedia-10-000-whys'
      assign c_pdp17_g_t1_title = 'Just the Encyclopedia'
      assign c_pdp17_g_t1_subtitle = '"10,000 Whys" only'
    when 'murphys-law-for-kids'
      assign c_pdp17_g_t1_title = "Just Murphy's Law"
      assign c_pdp17_g_t1_subtitle = c_pdp17_dquote | append: "Murphy's Law" | append: c_pdp17_dquote | append: ' only'
    when 'murphys-law-for-kids-copy'
      assign c_pdp17_g_t1_title = 'Just Leadership'
      assign c_pdp17_g_t1_subtitle = '"Leadership Enlightenment" only'
  endcase

  # Complete Set = 3 separate duplicate products (one per book, "-var-g"),
  # each already priced/discounted for this set — NOT a single bundle SKU.
  # Kaching's own "Choose Bundle" button adds all 3 to cart together; here we
  # reproduce that by adding all 3 variant IDs ourselves. One is picked as the
  # "main" tracked line (whichever book this PDP is currently on, so its own
  # quantity is what the cart shows front-and-center); the other two are
  # "linked" lines added alongside it via the same bundle_id/cleanup wiring
  # already used for free gifts elsewhere on this page — they are NOT free,
  # they're paid (already-discounted) books, we're just reusing the existing
  # multi-item-add + "remove main, remove all" mechanism for them too.
  assign c_pdp17_g_set_encyclopedia = all_products['kidss-encyclopedia-10-000-whys-var-g']
  assign c_pdp17_g_set_murphys = all_products['murphys-law-for-kids-var-g']
  assign c_pdp17_g_set_leadership = all_products['leadership-enlightenment-for-kids-var-g']

  assign c_pdp17_g_set_encyclopedia_variant_id = c_pdp17_g_set_encyclopedia.selected_or_first_available_variant.id
  assign c_pdp17_g_set_murphys_variant_id = c_pdp17_g_set_murphys.selected_or_first_available_variant.id
  assign c_pdp17_g_set_leadership_variant_id = c_pdp17_g_set_leadership.selected_or_first_available_variant.id

  assign c_pdp17_g_encyclopedia = all_products['kidss-encyclopedia-10-000-whys']
  assign c_pdp17_g_murphys = all_products['murphys-law-for-kids']
  assign c_pdp17_g_leadership = all_products['murphys-law-for-kids-copy']

  # Price/compare are LIVE sums of each duplicate/real product's OWN price —
  # not a hardcoded $79.90/$199.40 — so this stays correct in every market:
  # admin sets each "-var-g" duplicate's price in the shop's own currency same
  # as any product, and Shopify's per-market conversion applies to it exactly
  # like it does everywhere else; summing the already-converted amounts keeps
  # the total correct without us needing to know any exchange rate.
  assign c_pdp17_g_set_enc_price = c_pdp17_g_set_encyclopedia.selected_or_first_available_variant.price
  assign c_pdp17_g_set_mur_price = c_pdp17_g_set_murphys.selected_or_first_available_variant.price
  assign c_pdp17_g_set_lea_price = c_pdp17_g_set_leadership.selected_or_first_available_variant.price
  assign c_pdp17_g_t2_price = c_pdp17_g_set_enc_price | plus: c_pdp17_g_set_mur_price
  assign c_pdp17_g_t2_price = c_pdp17_g_t2_price | plus: c_pdp17_g_set_lea_price
  assign c_pdp17_g_t2_price = c_pdp17_g_t2_price | divided_by: 100.0 | ceil | times: 100 | minus: 10

  assign c_pdp17_g_enc_double = c_pdp17_g_encyclopedia.selected_or_first_available_variant.price | times: 2
  assign c_pdp17_g_mur_double = c_pdp17_g_murphys.selected_or_first_available_variant.price | times: 2
  assign c_pdp17_g_lea_double = c_pdp17_g_leadership.selected_or_first_available_variant.price | times: 2
  assign c_pdp17_g_t2_compare = c_pdp17_g_enc_double | plus: c_pdp17_g_mur_double | plus: c_pdp17_g_lea_double

  assign c_pdp17_g_t2_save = c_pdp17_g_t2_compare | minus: c_pdp17_g_t2_price

  assign c_pdp17_g_t2_ships_free = false
  if c_pdp17_g_t2_price >= c_pdp17_ship_threshold_cents
    assign c_pdp17_g_t2_ships_free = true
  endif

  # Each book's REAL/original variant id (not the -var-g duplicate) — needed so
  # that if a shopper clicks quantity+ on one of the set's book lines, we know
  # what to add a second, independently-priced unit of.
  assign c_pdp17_g_original_encyclopedia_variant_id = c_pdp17_g_encyclopedia.selected_or_first_available_variant.id
  assign c_pdp17_g_original_murphys_variant_id = c_pdp17_g_murphys.selected_or_first_available_variant.id
  assign c_pdp17_g_original_leadership_variant_id = c_pdp17_g_leadership.selected_or_first_available_variant.id

  # data-set-variant-ids carries "duplicateId:originalId" pairs for the OTHER 2
  # books in the set (the current PDP's own book is the anchor line itself).
  # All 3 books are co-equal "required" members of the set — removing or
  # altering ANY of them (not just the anchor) invalidates the whole bundle.
  case product.handle
    when 'kidss-encyclopedia-10-000-whys'
      assign c_pdp17_g_t2_variant_id = c_pdp17_g_set_encyclopedia_variant_id
      assign c_pdp17_g_t2_own_original_id = c_pdp17_g_original_encyclopedia_variant_id
      assign c_pdp17_g_t2_set_pairs = c_pdp17_g_set_murphys_variant_id | append: ':' | append: c_pdp17_g_original_murphys_variant_id | append: ',' | append: c_pdp17_g_set_leadership_variant_id | append: ':' | append: c_pdp17_g_original_leadership_variant_id
    when 'murphys-law-for-kids'
      assign c_pdp17_g_t2_variant_id = c_pdp17_g_set_murphys_variant_id
      assign c_pdp17_g_t2_own_original_id = c_pdp17_g_original_murphys_variant_id
      assign c_pdp17_g_t2_set_pairs = c_pdp17_g_set_encyclopedia_variant_id | append: ':' | append: c_pdp17_g_original_encyclopedia_variant_id | append: ',' | append: c_pdp17_g_set_leadership_variant_id | append: ':' | append: c_pdp17_g_original_leadership_variant_id
    when 'murphys-law-for-kids-copy'
      assign c_pdp17_g_t2_variant_id = c_pdp17_g_set_leadership_variant_id
      assign c_pdp17_g_t2_own_original_id = c_pdp17_g_original_leadership_variant_id
      assign c_pdp17_g_t2_set_pairs = c_pdp17_g_set_encyclopedia_variant_id | append: ':' | append: c_pdp17_g_original_encyclopedia_variant_id | append: ',' | append: c_pdp17_g_set_murphys_variant_id | append: ':' | append: c_pdp17_g_original_murphys_variant_id
  endcase

  # The 3 free gifts (Stickers/Mystery Gift/Gift Card), same as Var C/F — kept
  # separate from the set-member books, since gifts don't get the "add another
  # at original price" treatment, they just drop if the set becomes invalid.
  assign c_pdp17_g_t2_gift_ids = c_pdp17_c_t3_gift_ids

  # Var H: "Build your bundle" — identical on all 3 PDPs, no per-handle
  # branching needed. Uses each book's REAL plain variant (no duplicates —
  # pricing is a manual Shopify discount CODE our own JS applies, not a
  # duplicate-product bundle), reusing the same product lookups as Var G.
  assign c_pdp17_h_encyclopedia_variant_id = c_pdp17_g_original_encyclopedia_variant_id
  assign c_pdp17_h_murphys_variant_id = c_pdp17_g_original_murphys_variant_id
  assign c_pdp17_h_leadership_variant_id = c_pdp17_g_original_leadership_variant_id

  assign c_pdp17_h_encyclopedia_price = c_pdp17_g_encyclopedia.selected_or_first_available_variant.price
  assign c_pdp17_h_encyclopedia_price = c_pdp17_h_encyclopedia_price | divided_by: 100.0 | ceil | times: 100 | minus: 10
  assign c_pdp17_h_murphys_price = c_pdp17_g_murphys.selected_or_first_available_variant.price
  assign c_pdp17_h_murphys_price = c_pdp17_h_murphys_price | divided_by: 100.0 | ceil | times: 100 | minus: 10
  assign c_pdp17_h_leadership_price = c_pdp17_g_leadership.selected_or_first_available_variant.price
  assign c_pdp17_h_leadership_price = c_pdp17_h_leadership_price | divided_by: 100.0 | ceil | times: 100 | minus: 10
-%}

