{%- comment -%}
  "Pre-order" label on a cart line. Shown when the line has the hidden
  _preorder property (added by the Vol. 2 pre-order PDP — assets/c-preorder.js
  and assets/c-preorder-add-both.js). Its value is the shipping note, e.g.
  "Ships October 11".

  Accepts:
  - item: {Object} cart line item
{%- endcomment -%}

{%- if item.properties._preorder != blank -%}
  <span class="c-pre-cart-badge">
    Pre-order
    {%- if item.properties._preorder != 'true' %} · {{ item.properties._preorder }}{% endif -%}
  </span>
  <style>
    .c-pre-cart-badge {
      display: inline-block;
      margin: 4px 0 2px;
      padding: 3px 8px;
      border-radius: 6px;
      background: #fdecec;
      color: #b42318;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
  </style>
{%- endif -%}
