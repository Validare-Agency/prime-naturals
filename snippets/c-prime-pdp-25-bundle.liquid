{%- comment -%}
  PDP bundle tier picker (1 / 3 / 5 books).

  Forked from c-prime-pdp-22-bundle.liquid — shared bundle-row markup below
  is renamed c-pdp22-* -> c-pdp25-* / c_pdp22_* -> c_pdp25_* so this file's
  assets/c-prime-pdp-25.js never binds to the original's elements (and vice
  versa) if both are ever rendered on a page at once.

  assets/c-prime-pdp-25.css styles it; assets/c-prime-pdp-25.js wires row
  selection + Add to Cart.

  Accepts: product
{%- endcomment -%}

{%- liquid
  assign c_pdp25_variant = product.selected_or_first_available_variant
  assign c_pdp25_base_cents = c_pdp25_variant.price
  # See c-prime-pdp-17-bundle.liquid for why this rounds to a clean .90 ending
  # across markets instead of using Shopify's raw converted price.
  assign c_pdp25_base_cents = c_pdp25_base_cents | divided_by: 100.0 | ceil | times: 100 | minus: 10

  # Tier 1 always adds the live product's own variant — no bundling needed for
  # a single book.
  assign c_pdp25_t1_variant_id = c_pdp25_variant.id

  # Currency-agnostic handle check — see c-prime-pdp-17-bundle.liquid for the
  # full rationale (localized prices can't be compared against a fixed number).
  # Dropped when this file was first forked from c-prime-pdp-22-bundle.liquid —
  # restored, since the encyclopedia's tier 3 needs its own discount, not the
  # general formula (was showing $119.90 instead of $99.90).
  assign c_pdp25_is_encyclopedia = false
  if product.handle == 'kidss-encyclopedia-10-000-whys'
    assign c_pdp25_is_encyclopedia = true
  endif

  # Tier 1: 1 book, base price, no discount. Compare price is the site's
  # existing "50% off" anchor (base x2), same as shown everywhere else on the PDP.
  assign c_pdp25_a_t1_price = c_pdp25_base_cents
  assign c_pdp25_a_t1_compare = c_pdp25_base_cents | times: 2

  # Free shipping threshold: $55 USD-equivalent, vetted per-currency map.
  assign c_pdp25_ship_threshold_cents = 5500
  case cart.currency.iso_code
    when 'AUD' or 'CAD'
      assign c_pdp25_ship_threshold_cents = 8000
    when 'GBP'
      assign c_pdp25_ship_threshold_cents = 4500
    when 'NZD'
      assign c_pdp25_ship_threshold_cents = 9500
  endcase

  # BOGO framing display prices only — real discount comes from that product's
  # own native Kaching Bundles quantity-discount config (see c-prime-pdp-17-bundle.liquid).
  if c_pdp25_is_encyclopedia
    assign c_pdp25_d_t2_price = c_pdp25_base_cents | times: 7990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp25_d_t3_price = c_pdp25_base_cents | times: 9990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  else
    assign c_pdp25_d_t2_price = c_pdp25_base_cents | times: 5990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp25_d_t3_price = c_pdp25_base_cents | times: 8990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  endif

  assign c_pdp25_d_t2_compare = c_pdp25_base_cents | times: 3
  assign c_pdp25_d_t2_save = c_pdp25_d_t2_compare | minus: c_pdp25_d_t2_price

  assign c_pdp25_d_t3_compare = c_pdp25_base_cents | times: 5
  assign c_pdp25_d_t3_save = c_pdp25_d_t3_compare | minus: c_pdp25_d_t3_price

  assign c_pdp25_d_t2_ships_free = false
  if c_pdp25_d_t2_price >= c_pdp25_ship_threshold_cents
    assign c_pdp25_d_t2_ships_free = true
  endif

  assign c_pdp25_d_t3_ships_free = false
  if c_pdp25_d_t3_price >= c_pdp25_ship_threshold_cents
    assign c_pdp25_d_t3_ships_free = true
  endif

  # Tiers 2/3 add the SAME real product variant as tier 1, just at quantity 3
  # or 5 — see c-prime-pdp-17-bundle.liquid.
  assign c_pdp25_d_t2_variant_id = c_pdp25_variant.id
  assign c_pdp25_d_t3_variant_id = c_pdp25_variant.id
-%}

<div class="c-pdp25-variant">
  <p class="c-pdp25-eyebrow">&#9889; FLASH SALE &mdash; PRICES INCREASE IN 4 HOURS</p>

  <div class="c-pdp25-rows" role="radiogroup" aria-label="Bundle options">
    <label class="c-pdp25-row">
      <input
        type="radio"
        name="c-pdp25-tier-{{ section.id }}"
        class="c-pdp25-row__radio"
        data-variant-id="{{ c_pdp25_t1_variant_id }}"
        data-quantity="1"
        data-pdp25-price-money="{{ c_pdp25_a_t1_price | money }}"
        checked
      >
      <span class="c-pdp25-row__body">
        <span class="c-pdp25-row__title">1 Book</span>
        <span class="c-pdp25-row__subtitle">For 1 child</span>
      </span>
      <span class="c-pdp25-row__prices">
        <span class="c-pdp25-row__price">{{ c_pdp25_a_t1_price | money }}</span>
        <span class="c-pdp25-row__compare">{{ c_pdp25_a_t1_compare | money }}</span>
      </span>
    </label>

    <label class="c-pdp25-row">
      <span class="c-pdp25-row__badge c-pdp25-row__badge--popular c-pdp25-row__badge--sentence">Most popular</span>
      <input
        type="radio"
        name="c-pdp25-tier-{{ section.id }}"
        class="c-pdp25-row__radio"
        data-variant-id="{{ c_pdp25_d_t2_variant_id }}"
        data-quantity="3"
        data-pdp25-price-money="{{ c_pdp25_d_t2_price | money }}"
      >
      <span class="c-pdp25-row__body">
        <span class="c-pdp25-row__title">Buy 2, Get 1 Free</span>
        <span class="c-pdp25-row__subtitle">3 books &mdash; best for siblings</span>
        <span class="c-pdp25-row__perk">&#127873; 1 full book, on us</span>
        {%- if c_pdp25_d_t2_ships_free -%}
          <span class="c-pdp25-row__perk c-pdp25-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
      </span>
      <span class="c-pdp25-row__prices">
        <span class="c-pdp25-row__price">{{ c_pdp25_d_t2_price | money }}</span>
        <span class="c-pdp25-row__compare">{{ c_pdp25_d_t2_compare | money }}</span>
        <span class="c-pdp25-row__save">Save {{ c_pdp25_d_t2_save | money }}</span>
      </span>
    </label>

    <label class="c-pdp25-row">
      <span class="c-pdp25-row__badge c-pdp25-row__badge--popular c-pdp25-row__badge--sentence">One for every grandchild</span>
      <input
        type="radio"
        name="c-pdp25-tier-{{ section.id }}"
        class="c-pdp25-row__radio"
        data-variant-id="{{ c_pdp25_d_t3_variant_id }}"
        data-quantity="5"
        data-pdp25-price-money="{{ c_pdp25_d_t3_price | money }}"
      >
      <span class="c-pdp25-row__body">
        <span class="c-pdp25-row__title">Buy 3, Get 2 Free</span>
        <span class="c-pdp25-row__subtitle">5 books &mdash; best gift pack</span>
        <span class="c-pdp25-row__perk">&#127873; 2 full books, on us</span>
        {%- if c_pdp25_d_t3_ships_free -%}
          <span class="c-pdp25-row__perk c-pdp25-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
      </span>
      <span class="c-pdp25-row__prices">
        <span class="c-pdp25-row__price">{{ c_pdp25_d_t3_price | money }}</span>
        <span class="c-pdp25-row__compare">{{ c_pdp25_d_t3_compare | money }}</span>
        <span class="c-pdp25-row__save">Save {{ c_pdp25_d_t3_save | money }}</span>
      </span>
    </label>
  </div>

  <button type="button" class="c-pdp25-atc button button--full-width" data-pdp25-atc>
    <span data-pdp25-atc-price>{{ c_pdp25_a_t1_price | money }}</span>&nbsp;ADD TO CART
  </button>
</div>
