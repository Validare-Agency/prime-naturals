{%- comment -%} Locked card's dashed border — drawn as an SVG rect (custom
  stroke-dasharray) instead of CSS border-style:dashed, whose dash/gap ratio
  isn't controllable and varies by browser. Hidden for the unlocked state,
  which uses a real solid CSS border instead (see c-prime-pdp-25.css). {%- endcomment -%}
{%- capture c_pdp25_border_svg -%}
<svg class="c-pdp25-gift__border" viewBox="0 0 168 168" preserveAspectRatio="none" aria-hidden="true">
  <rect x="0.5" y="0.5" width="167" height="167" rx="10" ry="10"/>
</svg>
{%- endcapture -%}

{%- comment -%} V_PRIME_PDP_25 Var B only — same rows as Var A (fonts,
  border, functionality all unchanged), plus this product thumbnail at the
  front of each row. Hidden by default in CSS, shown only for
  body.c-primePdp25VarB. Same image for all 3 rows (same product, only
  quantity differs per tier). {%- endcomment -%}
{%- capture c_pdp25_row_image -%}
<img
  class="c-pdp25-row__image"
  src="{{ product.featured_image | image_url: width: 68 }}"
  alt=""
  aria-hidden="true"
  loading="lazy"
  width="34"
  height="47"
>
{%- endcapture -%}

<div class="c-pdp25-variant">
  <p class="c-pdp25-eyebrow">&#9889; FLASH SALE &mdash; PRICES INCREASE IN 4 HOURS</p>

  <div class="c-pdp25-rows" role="radiogroup" aria-label="Bundle options">
    <label class="c-pdp25-row">
      <input
        type="radio"
        name="c-pdp25-tier-{{ section.id }}"
        class="c-pdp25-row__radio"
        data-variant-id="{{ c_pdp25_t1_variant_id }}"
        data-quantity="1"
        data-pdp25-price-money="{{ c_pdp25_a_t1_price | money }}"
        checked
      >
      <span class="c-pdp25-row__image-wrap">
        {{ c_pdp25_row_image }}
      </span>
      <span class="c-pdp25-row__body">
        <span class="c-pdp25-row__title">1 Book</span>
        <span class="c-pdp25-row__subtitle">For 1 child</span>
      </span>
      <span class="c-pdp25-row__prices">
        <span class="c-pdp25-row__price">{{ c_pdp25_a_t1_price | money }}</span>
        <span class="c-pdp25-row__compare">{{ c_pdp25_a_t1_compare | money }}</span>
      </span>
    </label>

    <label class="c-pdp25-row c-pdp25-row--stacked">
      <span class="c-pdp25-row__badge c-pdp25-row__badge--popular c-pdp25-row__badge--sentence">Most popular</span>
      <input
        type="radio"
        name="c-pdp25-tier-{{ section.id }}"
        class="c-pdp25-row__radio"
        data-variant-id="{{ c_pdp25_d_t2_variant_id }}"
        data-quantity="3"
        data-pdp25-price-money="{{ c_pdp25_d_t2_price | money }}"
      >
      <span class="c-pdp25-row__image-wrap">
        {{ c_pdp25_row_image }}
        <span class="c-pdp25-row__free-badge">1x FREE</span>
      </span>
      <span class="c-pdp25-row__body">
        <span class="c-pdp25-row__title">Buy 2, Get 1 Free</span>
        <span class="c-pdp25-row__subtitle">3 books &mdash; best for siblings</span>
        <span class="c-pdp25-row__perk">&#127873; 1 full book, on us</span>
        {%- if c_pdp25_d_t2_ships_free -%}
          <span class="c-pdp25-row__perk c-pdp25-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
      </span>
      <span class="c-pdp25-row__prices">
        <span class="c-pdp25-row__price">{{ c_pdp25_d_t2_price | money }}</span>
        <span class="c-pdp25-row__compare">{{ c_pdp25_d_t2_compare | money }}</span>
        <span class="c-pdp25-row__save">Save {{ c_pdp25_d_t2_save | money }}</span>
      </span>
    </label>

    <label class="c-pdp25-row c-pdp25-row--stacked">
      <span class="c-pdp25-row__badge c-pdp25-row__badge--popular c-pdp25-row__badge--sentence">One for every grandchild</span>
      <input
        type="radio"
        name="c-pdp25-tier-{{ section.id }}"
        class="c-pdp25-row__radio"
        data-variant-id="{{ c_pdp25_d_t3_variant_id }}"
        data-quantity="5"
        data-pdp25-price-money="{{ c_pdp25_d_t3_price | money }}"
      >
      <span class="c-pdp25-row__image-wrap">
        {{ c_pdp25_row_image }}
        <span class="c-pdp25-row__free-badge">2x FREE</span>
      </span>
      <span class="c-pdp25-row__body">
        <span class="c-pdp25-row__title">Buy 3, Get 2 Free</span>
        <span class="c-pdp25-row__subtitle">5 books &mdash; best gift pack</span>
        <span class="c-pdp25-row__perk">&#127873; 2 full books, on us</span>
        {%- if c_pdp25_d_t3_ships_free -%}
          <span class="c-pdp25-row__perk c-pdp25-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
      </span>
      <span class="c-pdp25-row__prices">
        <span class="c-pdp25-row__price">{{ c_pdp25_d_t3_price | money }}</span>
        <span class="c-pdp25-row__compare">{{ c_pdp25_d_t3_compare | money }}</span>
        <span class="c-pdp25-row__save">Save {{ c_pdp25_d_t3_save | money }}</span>
      </span>
    </label>
  </div>

  {%- if c_pdp25_gift_mystery_variant or c_pdp25_gift_bookmark_variant or c_pdp25_gift_stickers_variant -%}
    {%- comment -%}
      Gift stack — hidden entirely for Control (see Test Setup in
      assets/c-prime-pdp-25.css). Each card renders server-side in its LOCKED
      state (matches the default 1-book selection); assets/c-prime-pdp-25.js
      toggles c-pdp25-gift--unlocked per card based on the selected row's
      data-quantity vs. that card's data-pdp25-unlock-qty.
    {%- endcomment -%}
    <div class="c-pdp25-gifts">
      {%- comment -%} Var C/D only say "Bonus Free Gifts" (no "Unlock") — both
        headings render, CSS shows the right one per variant (see
        assets/c-prime-pdp-25.css). {%- endcomment -%}
      <p class="c-pdp25-gifts__heading c-pdp25-gifts__heading--default">Unlock Bonus Free Gifts</p>
      <p class="c-pdp25-gifts__heading c-pdp25-gifts__heading--short">Bonus Free Gifts</p>
      <div class="c-pdp25-gifts__box">
        {%- if c_pdp25_gift_mystery_variant -%}
          <div
            class="c-pdp25-gift"
            data-pdp25-gift
            data-pdp25-gift-key="mystery"
            data-pdp25-unlock-qty="3"
            data-variant-id="{{ c_pdp25_gift_mystery_variant.id }}"
          >
            {{ c_pdp25_border_svg }}
            <span class="c-pdp25-gift__lock-circle" aria-hidden="true">{{ c_pdp25_lock_icon }}</span>
            <p class="c-pdp25-gift__unlock-copy">Unlock at 2 books</p>
