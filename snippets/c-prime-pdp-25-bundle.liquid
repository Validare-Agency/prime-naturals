                <p class="c-pdp25-gift__compare">{{ c_pdp25_gift_bookmark_variant.compare_at_price | money }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if c_pdp25_gift_stickers_variant -%}
          <div
            class="c-pdp25-gift"
            data-pdp25-gift
            data-pdp25-gift-key="stickers"
