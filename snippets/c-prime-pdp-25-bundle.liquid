            <span class="c-pdp25-gift__badge" aria-hidden="true">
              <span class="c-pdp25-gift__badge-icon c-pdp25-gift__badge-icon--lock">{{ c_pdp25_lock_icon }}</span>
              <span class="c-pdp25-gift__badge-icon c-pdp25-gift__badge-icon--check">{{ c_pdp25_check_icon }}</span>
            </span>
            <span class="c-pdp25-gift__media">
              <img
                class="c-pdp25-gift__image"
                src="{{ c_pdp25_gift_mystery_product.featured_image | image_url: width: 168 }}"
                alt="{{ c_pdp25_gift_mystery_product.featured_image.alt | default: c_pdp25_gift_mystery_product.title | escape }}"
                loading="lazy"
                width="70"
                height="78"
              >
              <span class="c-pdp25-gift__free-chip">FREE</span>
            </span>
            <div class="c-pdp25-gift__body">
              <p class="c-pdp25-gift__title">{{ c_pdp25_gift_mystery_product.title }}</p>
              {%- if c_pdp25_gift_mystery_variant.compare_at_price > 0 -%}
                <p class="c-pdp25-gift__compare">{{ c_pdp25_gift_mystery_variant.compare_at_price | money }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if c_pdp25_gift_bookmark_variant -%}
          <div
            class="c-pdp25-gift"
            data-pdp25-gift
            data-pdp25-gift-key="bookmark"
            data-pdp25-unlock-qty="5"
            data-variant-id="{{ c_pdp25_gift_bookmark_variant.id }}"
          >
            {{ c_pdp25_border_svg }}
            <span class="c-pdp25-gift__lock-circle" aria-hidden="true">{{ c_pdp25_lock_icon }}</span>
            <p class="c-pdp25-gift__unlock-copy">Unlock at 3 books</p>
            <p class="c-pdp25-gift__unlock-title">Bookmark</p>
            <span class="c-pdp25-gift__badge" aria-hidden="true">
              <span class="c-pdp25-gift__badge-icon c-pdp25-gift__badge-icon--lock">{{ c_pdp25_lock_icon }}</span>
              <span class="c-pdp25-gift__badge-icon c-pdp25-gift__badge-icon--check">{{ c_pdp25_check_icon }}</span>
            </span>
            <span class="c-pdp25-gift__media">
              <img
                class="c-pdp25-gift__image"
                src="{{ c_pdp25_gift_bookmark_product.featured_image | image_url: width: 168 }}"
                alt="{{ c_pdp25_gift_bookmark_product.featured_image.alt | default: c_pdp25_gift_bookmark_product.title | escape }}"
                loading="lazy"
                width="70"
                height="70"
              >
              <span class="c-pdp25-gift__free-chip">FREE</span>
            </span>
            <div class="c-pdp25-gift__body">
              <p class="c-pdp25-gift__title">{{ c_pdp25_gift_bookmark_product.title }}</p>
