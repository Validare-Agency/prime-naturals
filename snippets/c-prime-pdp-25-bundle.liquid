{%- comment -%}
  V_PRIME_PDP_25 | Offer iteration: winning BOGO + gift stack

  Forked from c-prime-pdp-22-bundle.liquid (do not merge changes back into that
  file — it stays untouched as the rollback target for this test). All shared
  markup below keeps c-pdp22-* class names so assets/c-prime-pdp-22.js continues
  to handle ATC, tier-price updates, and upsell interactions without changes.
  New gift-stack markup uses c-pdp25-* class names, wired by
  assets/c-prime-pdp-25.js. Liquid variables renamed c_pdp22_* → c_pdp25_*
  (server-side only; the HTML attribute names that JS reads are unchanged).

  Accepts: product, section
{%- endcomment -%}

{%- liquid
  assign c_pdp25_variant = product.selected_or_first_available_variant
  assign c_pdp25_base_cents = c_pdp25_variant.price
  # See c-prime-pdp-17-bundle.liquid for the .90-ending rounding rationale.
  assign c_pdp25_base_cents = c_pdp25_base_cents | divided_by: 100.0 | ceil | times: 100 | minus: 10

  assign c_pdp25_t1_variant_id = c_pdp25_variant.id

  assign c_pdp25_is_encyclopedia = false
  if product.handle == 'kidss-encyclopedia-10-000-whys'
    assign c_pdp25_is_encyclopedia = true
  endif

  assign c_pdp25_a_t1_price = c_pdp25_base_cents
  assign c_pdp25_a_t1_compare = c_pdp25_base_cents | times: 2

  assign c_pdp25_ship_threshold_cents = 5500
  case cart.currency.iso_code
    when 'AUD' or 'CAD'
      assign c_pdp25_ship_threshold_cents = 8000
    when 'GBP'
      assign c_pdp25_ship_threshold_cents = 4500
    when 'NZD'
      assign c_pdp25_ship_threshold_cents = 9500
  endcase

  if c_pdp25_is_encyclopedia
    assign c_pdp25_d_t2_price = c_pdp25_base_cents | times: 7990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp25_d_t3_price = c_pdp25_base_cents | times: 9990.0 | divided_by: 3990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  else
    assign c_pdp25_d_t2_price = c_pdp25_base_cents | times: 5990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
    assign c_pdp25_d_t3_price = c_pdp25_base_cents | times: 8990.0 | divided_by: 2990.0 | round: 0 | divided_by: 100.0 | ceil | times: 100 | minus: 10
  endif

  assign c_pdp25_d_t2_compare = c_pdp25_base_cents | times: 3
  assign c_pdp25_d_t2_save = c_pdp25_d_t2_compare | minus: c_pdp25_d_t2_price

  assign c_pdp25_d_t3_compare = c_pdp25_base_cents | times: 5
  assign c_pdp25_d_t3_save = c_pdp25_d_t3_compare | minus: c_pdp25_d_t3_price

  assign c_pdp25_d_t2_ships_free = false
  if c_pdp25_d_t2_price >= c_pdp25_ship_threshold_cents
    assign c_pdp25_d_t2_ships_free = true
  endif

  assign c_pdp25_d_t3_ships_free = false
  if c_pdp25_d_t3_price >= c_pdp25_ship_threshold_cents
    assign c_pdp25_d_t3_ships_free = true
  endif

  assign c_pdp25_d_t2_variant_id = c_pdp25_variant.id
  assign c_pdp25_d_t3_variant_id = c_pdp25_variant.id

  # V_PRIME_PDP_22 upsell — encyclopedia only. Kept here so the upsell
  # experiment continues to run alongside this test without a separate snippet
  # render. Class names stay c-pdp22-* so c-prime-pdp-22.js/.css still bind.
  if c_pdp25_is_encyclopedia
    assign c_pdp25_upsell_leadership_product = all_products['murphys-law-for-kids-copy']
    assign c_pdp25_upsell_leadership_variant = c_pdp25_upsell_leadership_product.selected_or_first_available_variant
    assign c_pdp25_upsell_leadership_compare = c_pdp25_upsell_leadership_variant.compare_at_price
    if c_pdp25_upsell_leadership_compare == blank or c_pdp25_upsell_leadership_compare <= c_pdp25_upsell_leadership_variant.price
      assign c_pdp25_upsell_leadership_compare = c_pdp25_upsell_leadership_variant.price | times: 2
    endif

    assign c_pdp25_upsell_murphys_product = all_products['murphys-law-for-kids']
    assign c_pdp25_upsell_murphys_variant = c_pdp25_upsell_murphys_product.selected_or_first_available_variant
    assign c_pdp25_upsell_murphys_compare = c_pdp25_upsell_murphys_variant.compare_at_price
    if c_pdp25_upsell_murphys_compare == blank or c_pdp25_upsell_murphys_compare <= c_pdp25_upsell_murphys_variant.price
      assign c_pdp25_upsell_murphys_compare = c_pdp25_upsell_murphys_variant.price | times: 2
    endif
  endif
-%}

{{- '<!-- V_PRIME_PDP_25 bundle + gift stack -->' -}}
<div class="c-pdp22-variant c-pdp22-variant--d c-pdp25-variant">
  <p class="c-pdp22-eyebrow">&#9889; FLASH SALE &mdash; PRICES INCREASE IN 4 HOURS</p>

  <div class="c-pdp22-rows" role="radiogroup" aria-label="Bundle options">

    {%- comment -%} Tier 1: 1 book {%- endcomment -%}
    <label class="c-pdp22-row">
      <input
        type="radio"
        name="c-pdp22-d-tier-{{ section.id }}"
        class="c-pdp22-row__radio"
        data-variant-id="{{ c_pdp25_t1_variant_id }}"
        data-quantity="1"
        data-pdp22-price-money="{{ c_pdp25_a_t1_price | money }}"
        {%- if c_pdp25_upsell_leadership_variant %}
        data-pdp22-price-with-upsell-leadership-money="{{ c_pdp25_a_t1_price | plus: c_pdp25_upsell_leadership_variant.price | money }}"
        {%- endif %}
        {%- if c_pdp25_upsell_murphys_variant %}
        data-pdp22-price-with-upsell-murphys-money="{{ c_pdp25_a_t1_price | plus: c_pdp25_upsell_murphys_variant.price | money }}"
        {%- endif %}
        {%- if c_pdp25_upsell_leadership_variant and c_pdp25_upsell_murphys_variant %}
        data-pdp22-price-with-both-upsells-money="{{ c_pdp25_a_t1_price | plus: c_pdp25_upsell_leadership_variant.price | plus: c_pdp25_upsell_murphys_variant.price | money }}"
        {%- endif %}
        checked
      >
      <span class="c-pdp22-row__body">
        <span class="c-pdp22-row__title">1 Book</span>
        <span class="c-pdp22-row__subtitle">For 1 child</span>
      </span>
      <span class="c-pdp22-row__prices">
        <span class="c-pdp22-row__price">{{ c_pdp25_a_t1_price | money }}</span>
        <span class="c-pdp22-row__compare">{{ c_pdp25_a_t1_compare | money }}</span>
      </span>
    </label>

    {%- comment -%} Tier 2: Buy 2 Get 1 Free (3 books) {%- endcomment -%}
    <label class="c-pdp22-row">
      <span class="c-pdp22-row__badge c-pdp22-row__badge--popular c-pdp22-row__badge--sentence">Most popular</span>
      <input
        type="radio"
        name="c-pdp22-d-tier-{{ section.id }}"
        class="c-pdp22-row__radio"
        data-variant-id="{{ c_pdp25_d_t2_variant_id }}"
        data-quantity="3"
        data-pdp22-price-money="{{ c_pdp25_d_t2_price | money }}"
        {%- if c_pdp25_upsell_leadership_variant %}
        data-pdp22-price-with-upsell-leadership-money="{{ c_pdp25_d_t2_price | plus: c_pdp25_upsell_leadership_variant.price | money }}"
        {%- endif %}
        {%- if c_pdp25_upsell_murphys_variant %}
        data-pdp22-price-with-upsell-murphys-money="{{ c_pdp25_d_t2_price | plus: c_pdp25_upsell_murphys_variant.price | money }}"
        {%- endif %}
        {%- if c_pdp25_upsell_leadership_variant and c_pdp25_upsell_murphys_variant %}
        data-pdp22-price-with-both-upsells-money="{{ c_pdp25_d_t2_price | plus: c_pdp25_upsell_leadership_variant.price | plus: c_pdp25_upsell_murphys_variant.price | money }}"
        {%- endif %}
      >
      <span class="c-pdp22-row__body">
        <span class="c-pdp22-row__title">Buy 2, Get 1 Free</span>
        <span class="c-pdp22-row__subtitle">3 books &mdash; best for siblings</span>
        <span class="c-pdp22-row__perk">&#127873; 1 full book, on us</span>
        {%- if c_pdp25_d_t2_ships_free -%}
          <span class="c-pdp22-row__perk c-pdp22-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
      </span>
      <span class="c-pdp22-row__prices">
        <span class="c-pdp22-row__price">{{ c_pdp25_d_t2_price | money }}</span>
        <span class="c-pdp22-row__compare">{{ c_pdp25_d_t2_compare | money }}</span>
        <span class="c-pdp22-row__save">Save {{ c_pdp25_d_t2_save | money }}</span>
      </span>
    </label>

    {%- comment -%} Tier 3: Buy 3 Get 2 Free (5 books) {%- endcomment -%}
    <label class="c-pdp22-row">
      <span class="c-pdp22-row__badge c-pdp22-row__badge--popular c-pdp22-row__badge--sentence">One for every grandchild</span>
      <input
        type="radio"
        name="c-pdp22-d-tier-{{ section.id }}"
        class="c-pdp22-row__radio"
        data-variant-id="{{ c_pdp25_d_t3_variant_id }}"
        data-quantity="5"
        data-pdp22-price-money="{{ c_pdp25_d_t3_price | money }}"
        {%- if c_pdp25_upsell_leadership_variant %}
        data-pdp22-price-with-upsell-leadership-money="{{ c_pdp25_d_t3_price | plus: c_pdp25_upsell_leadership_variant.price | money }}"
        {%- endif %}
        {%- if c_pdp25_upsell_murphys_variant %}
        data-pdp22-price-with-upsell-murphys-money="{{ c_pdp25_d_t3_price | plus: c_pdp25_upsell_murphys_variant.price | money }}"
        {%- endif %}
        {%- if c_pdp25_upsell_leadership_variant and c_pdp25_upsell_murphys_variant %}
        data-pdp22-price-with-both-upsells-money="{{ c_pdp25_d_t3_price | plus: c_pdp25_upsell_leadership_variant.price | plus: c_pdp25_upsell_murphys_variant.price | money }}"
        {%- endif %}
      >
      <span class="c-pdp22-row__body">
        <span class="c-pdp22-row__title">
          Buy 3, Get 2 Free
          <span class="c-pdp25-2x-badge">2x FREE</span>
        </span>
        <span class="c-pdp22-row__subtitle">5 books &mdash; best gift pack</span>
        <span class="c-pdp22-row__perk">&#127873; 2 full books, on us</span>
        {%- if c_pdp25_d_t3_ships_free -%}
          <span class="c-pdp22-row__perk c-pdp22-row__perk--ship">&#128666; FREE shipping</span>
        {%- endif -%}
      </span>
      <span class="c-pdp22-row__prices">
        <span class="c-pdp22-row__price">{{ c_pdp25_d_t3_price | money }}</span>
        <span class="c-pdp22-row__compare">{{ c_pdp25_d_t3_compare | money }}</span>
        <span class="c-pdp22-row__save">Save {{ c_pdp25_d_t3_save | money }}</span>
      </span>
    </label>

  </div>

  {%- comment -%}
    V_PRIME_PDP_25 gift stack — rendered for every visitor; CSS gates
    visibility by body class (hidden for Control, visible for Var A/B/C).
    JS (c-prime-pdp-25.js) updates data-pdp25-unlocked on each gift when
    the selected tier changes; the default HTML state (all locked, tier 1
    selected) matches the checked radio above.
  {%- endcomment -%}
  <div class="c-pdp25-gifts" data-pdp25-gifts>
    <p class="c-pdp25-gifts__heading c-pdp25-gifts__heading--unlock">&#127775; UNLOCK BONUS FREE GIFTS</p>
    <p class="c-pdp25-gifts__heading c-pdp25-gifts__heading--bonus">&#127873; BONUS FREE GIFTS</p>

    <div class="c-pdp25-gifts__row">

      {%- comment -%} Gift 1: Mystery Gift (sticker) — unlocks at tier 2 {%- endcomment -%}
      <div class="c-pdp25-gift" data-pdp25-gift data-pdp25-gift-min-tier="2" data-pdp25-unlocked="false">
        <div class="c-pdp25-gift__tile">
          <div class="c-pdp25-gift__image-wrap">
            <span class="c-pdp25-gift__lock-overlay" aria-hidden="true">
              {% render 'c-pdp17-icon-lock' %}
            </span>
            <span class="c-pdp25-gift__icon" aria-hidden="true">🎁</span>
          </div>
          <p class="c-pdp25-gift__threshold">Unlock at 2 books</p>
          <p class="c-pdp25-gift__name">Mystery Gift</p>
          <p class="c-pdp25-gift__value">$9.80 value</p>
          <p class="c-pdp25-gift__free">FREE</p>
        </div>
      </div>

      {%- comment -%} Gift 2: Bookmark — unlocks at tier 3 {%- endcomment -%}
      <div class="c-pdp25-gift" data-pdp25-gift data-pdp25-gift-min-tier="3" data-pdp25-unlocked="false">
        <div class="c-pdp25-gift__tile">
          <div class="c-pdp25-gift__image-wrap">
            <span class="c-pdp25-gift__lock-overlay" aria-hidden="true">
              {% render 'c-pdp17-icon-lock' %}
            </span>
            <span class="c-pdp25-gift__icon" aria-hidden="true">🔖</span>
          </div>
          <p class="c-pdp25-gift__threshold">Unlock at 3 books</p>
          <p class="c-pdp25-gift__name">Bookmark</p>
          <p class="c-pdp25-gift__value">$4.80 value</p>
          <p class="c-pdp25-gift__free">FREE</p>
        </div>
      </div>

      {%- comment -%} Gift 3: Sticker Puzzle — unlocks at tier 3 {%- endcomment -%}
      <div class="c-pdp25-gift" data-pdp25-gift data-pdp25-gift-min-tier="3" data-pdp25-unlocked="false">
        <div class="c-pdp25-gift__tile">
          <div class="c-pdp25-gift__image-wrap">
            <span class="c-pdp25-gift__lock-overlay" aria-hidden="true">
              {% render 'c-pdp17-icon-lock' %}
            </span>
            <span class="c-pdp25-gift__icon" aria-hidden="true">🧩</span>
          </div>
          <p class="c-pdp25-gift__threshold">Unlock at 3 books</p>
          <p class="c-pdp25-gift__name">Sticker Puzzle</p>
          <p class="c-pdp25-gift__value">$15.80 value</p>
          <p class="c-pdp25-gift__free">FREE</p>
        </div>
      </div>

    </div>
  </div>

  {%- comment -%} V_PRIME_PDP_22 upsell card — class names stay c-pdp22-* so
    c-prime-pdp-22.js and c-prime-pdp-22.css continue to work unchanged. {%- endcomment -%}
  {%- if c_pdp25_upsell_leadership_product != blank or c_pdp25_upsell_murphys_product != blank -%}
    <div class="c-pdp22-upsell">
      <p class="c-pdp22-upsell__eyebrow">Most Grandparents Bought This Together!</p>

      {%- if c_pdp25_upsell_leadership_product != blank -%}
        <div class="c-pdp22-upsell__card" data-pdp22-upsell data-pdp22-upsell-key="leadership" data-variant-id="{{ c_pdp25_upsell_leadership_variant.id }}">
          <label class="c-pdp22-upsell__checkbox-wrap">
            <input type="checkbox" class="c-pdp22-upsell__checkbox" data-pdp22-checkbox>
          </label>
          <img
            class="c-pdp22-upsell__image"
            src="{{ c_pdp25_upsell_leadership_product.featured_image | image_url: width: 184 }}"
            alt="{{ c_pdp25_upsell_leadership_product.featured_image.alt | default: c_pdp25_upsell_leadership_product.title | escape }}"
            loading="lazy"
            width="92"
            height="92"
          >
          <div class="c-pdp22-upsell__body">
            <p class="c-pdp22-upsell__title">{{ c_pdp25_upsell_leadership_product.title }}</p>
            <p class="c-pdp22-upsell__desc">Teaches your child to lead and communicate in any situation</p>
          </div>
          <div class="c-pdp22-upsell__side">
            <div class="c-pdp22-upsell__price-block">
              <span class="c-pdp22-upsell__price">{{ c_pdp25_upsell_leadership_variant.price | money }}</span>
              <span class="c-pdp22-upsell__compare">{{ c_pdp25_upsell_leadership_compare | money }}</span>
            </div>
            <button type="button" class="c-pdp22-upsell__add-btn" data-pdp22-add-btn>Add</button>
          </div>
        </div>
      {%- endif -%}

      {%- if c_pdp25_upsell_murphys_product != blank -%}
        <div class="c-pdp22-upsell__card" data-pdp22-upsell data-pdp22-upsell-key="murphys" data-variant-id="{{ c_pdp25_upsell_murphys_variant.id }}">
          <label class="c-pdp22-upsell__checkbox-wrap">
            <input type="checkbox" class="c-pdp22-upsell__checkbox" data-pdp22-checkbox>
          </label>
          <img
            class="c-pdp22-upsell__image"
            src="{{ c_pdp25_upsell_murphys_product.featured_image | image_url: width: 184 }}"
            alt="{{ c_pdp25_upsell_murphys_product.featured_image.alt | default: c_pdp25_upsell_murphys_product.title | escape }}"
            loading="lazy"
            width="92"
            height="92"
          >
          <div class="c-pdp22-upsell__body">
            <p class="c-pdp22-upsell__title">{{ c_pdp25_upsell_murphys_product.title }}</p>
            <p class="c-pdp22-upsell__desc">Teaches your child to handle anything life throws at them</p>
          </div>
          <div class="c-pdp22-upsell__side">
            <div class="c-pdp22-upsell__price-block">
              <span class="c-pdp22-upsell__price">{{ c_pdp25_upsell_murphys_variant.price | money }}</span>
              <span class="c-pdp22-upsell__compare">{{ c_pdp25_upsell_murphys_compare | money }}</span>
            </div>
            <button type="button" class="c-pdp22-upsell__add-btn" data-pdp22-add-btn>Add</button>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <button type="button" class="c-pdp22-atc button button--full-width" data-pdp22-atc>
    <span data-pdp22-atc-price>{{ c_pdp25_a_t1_price | money }}</span>&nbsp;ADD TO CART
  </button>
</div>
