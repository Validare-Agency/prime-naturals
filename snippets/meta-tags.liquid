{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<script src="{{ 'cart_counter.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product_variant_selector.js' | asset_url }}" ></script>
  <script src="{{ 'product_stock_alert.js' | asset_url }}" ></script>
 <script src="{{ 'product_price.js' | asset_url }}" ></script> 
 <script src="{{ 'slideshow_thumbnails.js' | asset_url }}" ></script>

<script type="text/javascript">
  const observer = new MutationObserver(mutations => {
    mutations.forEach(({ addedNodes }) => {
      addedNodes.forEach(node => {
        // Sirf SCRIPT tags ko target karein
        if (node.nodeType === 1 && node.tagName === "SCRIPT") {
          const content = node.innerHTML || "";
          const src = node.src || "";

          // 1. Analytics aur Facebook ko SKIP karein (Inhein delay nahi karna)
          if (
            src.includes("connect.facebook.net") || 
            src.includes("google-analytics") || 
            src.includes("googletagmanager") || 
            node.classList.contains('analytics')
          ) {
            return; // In scripts ko mat chhairrein
          }

          // 2. Shopify ki non-essential scripts ko lazy load karein
          if (content.includes("asyncLoad")) {
            node.innerHTML = content.replace(
              "if(window.attachEvent)", 
              "document.addEventListener('asyncLazyLoad',function(event){asyncLoad();});if(window.attachEvent)"
            ).replaceAll(", asyncLoad", ", function(){}");
          }

          // 3. Preview Bar ko smooth rakhein (Design mode check)
          if (content.includes("PreviewBarInjector") && !Shopify.designMode) {
            node.innerHTML = content.replace("DOMContentLoaded", "asyncLazyLoad");
          }

          // 4. Baqi external features ko delay karein (Shopify Pay, etc.)
          if (src.includes("assets/shopify_pay") || src.includes("assets/storefront/features")) {
            node.setAttribute("data-src", src);
            node.removeAttribute("src");
          }
        }
      });
    });
  });

  observer.observe(document.documentElement, { child { childList: true, subtree: true });

  // 5. User action par scripts ko trigger karne ka function
  const triggerScripts = () => {
    if (window.scriptsTriggered) return;
    window.scriptsTriggered = true;
    
    // Custom event fire karein
    document.dispatchEvent(new CustomEvent('asyncLazyLoad'));
    
    // data-src wali scripts ko load karein
    document.querySelectorAll('script[data-src]').forEach(s => {
      s.src = s.getAttribute('data-src');
      s.removeAttribute('data-src');
    });
    
    // Listeners remove karein
    ['touchstart', 'mousemove', 'scroll', 'keydown'].forEach(e => 
      window.removeEventListener(e, triggerScripts)
    );
  };

  // User activity ka intezar karein
  ['touchstart', 'mousemove', 'scroll', 'keydown'].forEach(e => 
    window.addEventListener(e, triggerScripts, { passive: true })
  );
</script>
